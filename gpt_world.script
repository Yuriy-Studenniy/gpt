        category = "landmark",
        anchor_entity_id = "smart:zaton:zat_b100",
        source_records = { "simulation.ltx:start_position_zaton", "simulation_objects_props.ltx:zat_b100" }
    },
    ["poi:zaton:old_barge"] = {
        entity_id = "poi:zaton:old_barge",
        entity_type = "poi",
        level_id = "level:zaton",
        display_name = "Старая баржа",
        category = "hideout",
        anchor_entity_id = "smart:zaton:zat_b18",
        source_records = { "simulation.ltx:start_position_zaton:zat_b18_noah_squad" }
    }
}

local function gpt_world_copy_record(record)
    if type(record) ~= "table" then
        return nil
    end

    local copy = {}
    for key, value in pairs(record) do
        if type(value) == "table" then
            local nested = {}
            for nested_key, nested_value in pairs(value) do
                nested[nested_key] = nested_value
            end
            copy[key] = nested
        else
            copy[key] = value
        end
    end
    return copy
end

-- Static catalog lookup. Catalog presence must never be treated as
-- evidence that the companion knows or has visited the location.
function gpt_world.get_catalog_entity(entity_id)
    if type(entity_id) ~= "string" then
        return nil
    end

    local record = GPT_WORLD_LEVEL_CATALOG[entity_id]
        or GPT_WORLD_SMART_TERRAIN_CATALOG[entity_id]
        or GPT_WORLD_POI_CATALOG[entity_id]
    return gpt_world_copy_record(record)
end

-- Returns a fresh array of static Smart Terrain descriptors. Passing nil
-- returns all catalogued entries; a level entity ID filters the result.
function gpt_world.get_catalog_smart_terrains(level_entity_id)
    if level_entity_id ~= nil and type(level_entity_id) ~= "string" then
        return {}
    end

    local result = {}
    for _, record in pairs(GPT_WORLD_SMART_TERRAIN_CATALOG) do
        if level_entity_id == nil or record.level_id == level_entity_id then
            result[#result + 1] = gpt_world_copy_record(record)
        end
    end

    table.sort(result, function(left, right)
        return left.entity_id < right.entity_id
    end)

    return result
end

-- Returns a fresh array of named POIs. Catalog presence never implies knowledge.
function gpt_world.get_catalog_pois(level_entity_id)
    if level_entity_id ~= nil and type(level_entity_id) ~= "string" then
        return {}
    end

    local result = {}
    for _, record in pairs(GPT_WORLD_POI_CATALOG) do
        if level_entity_id == nil or record.level_id == level_entity_id then
            result[#result + 1] = gpt_world_copy_record(record)
        end
    end

    table.sort(result, function(left, right)
        return left.entity_id < right.entity_id
    end)

    return result
end

-- Returns a fresh array of static level descriptors.
-- It is intentionally separate from the companion's known-place queries.
function gpt_world.get_catalog_levels()
    local result = {}
    for entity_id, record in pairs(GPT_WORLD_LEVEL_CATALOG) do
        result[#result + 1] = gpt_world_copy_record(record)
    end

    table.sort(result, function(left, right)
        return left.entity_id < right.entity_id
    end)

    return result
end

local function gpt_world_safe_index(object, field_name)
    if object == nil then
        return nil
    end

    local ok, value = pcall(function()
        return object[field_name]
    end)

    if ok then
        return value
    end

    return nil
end

local function gpt_world_safe_method(object, method_name, ...)
    local method = gpt_world_safe_index(object, method_name)
    if type(method) ~= "function" then
        return nil
    end

    local ok, value = pcall(method, object, ...)
    if ok then
        return value
    end

    return nil
end

local function gpt_world_get_alife()
    if type(alife) ~= "function" then
        return nil
    end

    local ok, simulation = pcall(alife)
    if ok then
        return simulation
    end

    return nil
end

local function gpt_world_get_game_graph()
    if type(game_graph) ~= "function" then
        return nil
    end

    local ok, graph = pcall(game_graph)
    if ok then
        return graph
    end

    return nil
end

local function gpt_world_get_companion_server_object(simulation, requested_companion_id)
    -- Callers that already hold the A-Life ID can avoid depending on the
    -- Story ID registry having been refreshed at this exact update.
    if requested_companion_id ~= nil then
        if type(requested_companion_id) ~= "number" or requested_companion_id <= 0 then
            return nil, "invalid_companion_id"
        end

        local requested_companion = gpt_world_safe_method(simulation, "object", requested_companion_id)
        if requested_companion == nil then
            return nil, "companion_object_unavailable"
        end

        return requested_companion, requested_companion_id
    end

    if type(get_story_object_id) ~= "function" then
        return nil, "story_id_lookup_unavailable"
    end

    local ok, companion_id = pcall(get_story_object_id, GPT_WORLD_COMPANION_STORY_ID)
    if not ok then
        return nil, "story_id_lookup_failed"
    end
    if type(companion_id) ~= "number" then
        return nil, "companion_not_registered"
    end

    local companion = gpt_world_safe_method(simulation, "object", companion_id)
    if companion == nil then
        return nil, "companion_object_unavailable"
    end

    return companion, companion_id
end

local function gpt_world_get_online_companion_object(companion_id)
    if type(db) ~= "table" then
        return nil
    end

    local storage = gpt_world_safe_index(db, "storage")
    local companion_storage = gpt_world_safe_index(storage, companion_id)
    return gpt_world_safe_index(companion_storage, "object")
end

local function gpt_world_get_game_vertex_id(companion)
    local game_vertex_id = gpt_world_safe_index(companion, "m_game_vertex_id")
    if type(game_vertex_id) == "number" then
        return game_vertex_id
    end

    game_vertex_id = gpt_world_safe_method(companion, "game_vertex_id")
    if type(game_vertex_id) == "number" then
        return game_vertex_id
    end

    return nil
end

local function gpt_world_resolve_level(simulation, graph, game_vertex_id)
    if type(game_vertex_id) ~= "number" then
        return nil
    end

    local vertex = gpt_world_safe_method(graph, "vertex", game_vertex_id)
    if vertex == nil then
        return nil
    end

    local level_id = gpt_world_safe_method(vertex, "level_id")
    if type(level_id) ~= "number" then
        return nil
    end

    local level_name = gpt_world_safe_method(simulation, "level_name", level_id)
    if type(level_name) ~= "string" or level_name == "" then
        return nil
    end

    return {
        entity_id = "level:" .. level_name,
        name = level_name,
        game_graph_level_id = level_id,
        game_vertex_id = game_vertex_id
    }
end

local function gpt_world_resolve_smart_terrain(simulation, server_companion, online_companion, level_name)
    local smart_terrain_id = gpt_world_safe_index(online_companion, "m_smart_terrain_id")
    if type(smart_terrain_id) ~= "number" then
        smart_terrain_id = gpt_world_safe_index(server_companion, "m_smart_terrain_id")
    end

    if type(smart_terrain_id) ~= "number" then
        return nil, "smart_terrain_id_unavailable", nil
    end
    if smart_terrain_id == GPT_WORLD_NO_SMART_TERRAIN_ID or smart_terrain_id <= 0 then
        return nil, "no_smart_terrain_assigned", smart_terrain_id
    end

    local smart_terrain = gpt_world_safe_method(simulation, "object", smart_terrain_id)
    if smart_terrain == nil then
        return nil, "smart_terrain_object_unavailable", smart_terrain_id
    end

    local smart_terrain_name = gpt_world_safe_method(smart_terrain, "name")
    if type(smart_terrain_name) ~= "string" or smart_terrain_name == "" then
        return nil, "smart_terrain_name_unavailable", smart_terrain_id
    end

    local parent_level = level_name
    if type(parent_level) ~= "string" or parent_level == "" then
        parent_level = "unknown"
    end

    return {
        entity_id = "smart:" .. parent_level .. ":" .. smart_terrain_name,
        name = smart_terrain_name,
        alife_object_id = smart_terrain_id
    }, "resolved", smart_terrain_id
end

-- Returns objective engine context only.
-- The returned table is not the companion's knowledge and must not be sent
-- directly to dialogue/LLM as a list of places the character knows.
--
-- Success:
--   snapshot, nil
-- Failure:
--   nil, stable_error_code
-- Pass companion_alife_id when the caller already has a current A-Life
-- object ID. With no argument, resolve the unique companion through Story ID.
function gpt_world.get_companion_location_snapshot(companion_alife_id)
    local simulation = gpt_world_get_alife()
    if simulation == nil then
        return nil, "alife_unavailable"
    end

    local companion, companion_id = gpt_world_get_companion_server_object(simulation, companion_alife_id)
    if companion == nil then
        return nil, companion_id
    end

    -- The online object exposes the live game vertex. The server-side
    -- A-Life object is the fallback for an offline companion.
    local online_companion = gpt_world_get_online_companion_object(companion_id)
    local runtime_companion = online_companion or companion
    local game_vertex_id = gpt_world_get_game_vertex_id(runtime_companion)
    if game_vertex_id == nil and runtime_companion ~= companion then
        game_vertex_id = gpt_world_get_game_vertex_id(companion)
    end
    if game_vertex_id == nil then
        return nil, "companion_game_vertex_unavailable"
    end

    local graph = gpt_world_get_game_graph()
    if graph == nil then
        return nil, "game_graph_unavailable"
    end

    local level = gpt_world_resolve_level(simulation, graph, game_vertex_id)
    if level == nil then
        return nil, "companion_level_unavailable"
    end

    local smart_terrain, smart_terrain_status, smart_terrain_id = gpt_world_resolve_smart_terrain(
        simulation,
        companion,
        online_companion,
        level.name
    )

    return {
        companion_story_id = GPT_WORLD_COMPANION_STORY_ID,
        companion_alife_object_id = companion_id,
        is_online = online_companion ~= nil,
        level = level,
        smart_terrain = smart_terrain,
        smart_terrain_status = smart_terrain_status,
        smart_terrain_alife_object_id = smart_terrain_id,
        source = "xray_alife_snapshot"
    }, nil
end


-- Companion knowledge is separate from the engine snapshot and static catalog.
-- Confirmed known places use the actor's existing PSTOR save channel as a
-- compatibility bridge. It is already serialized by actor_binder save/load;
-- the companion squad's binary STATE_Write/STATE_Read packet is not modified.
-- A future dedicated companion-memory backend can replace this bridge.
local GPT_WORLD_CLAIMS = {}
local GPT_WORLD_NEXT_CLAIM_ID = 1
local GPT_WORLD_MAX_CLAIMS = 512
local GPT_WORLD_PERSISTENCE_KEY = "gpt_world_known_places_v1"
local GPT_WORLD_MAX_PERSISTED_PLACES = 256
local GPT_WORLD_PERSISTENCE_SUSPENDED = false
local GPT_WORLD_PENDING_SAVE_RESTORE_CHECK = false

local GPT_WORLD_CLAIM_STATUSES = {
    observed = true,
    reported = true,
    inferred = true
}

local function gpt_world_is_nonempty_string(value)
    return type(value) == "string" and value ~= ""
        and string.find(value, ":", 1, true) ~= nil
end

local function gpt_world_is_claim_scalar(value)
    local value_type = type(value)
    return value_type == "string" or value_type == "number" or value_type == "boolean"
end

local function gpt_world_copy_claim(claim)
    if type(claim) ~= "table" then
        return nil
    end

    local copy = {}
    for key, value in pairs(claim) do
        if type(value) ~= "table" then
            copy[key] = value
        end
    end
    return copy
end

-- The actor's PSTOR is an existing save-backed scalar store in stock CoP.
-- We only serialize catalog entity IDs; no engine pointers or Lua tables enter it.
local function gpt_world_get_actor_pstor()
    if type(db) ~= "table" or db.actor == nil
        or type(db.storage) ~= "table" then
        return nil, "actor_storage_unavailable"
    end
    if type(xr_logic) ~= "table"
        or type(xr_logic.pstor_retrieve) ~= "function"
        or type(xr_logic.pstor_store) ~= "function" then
        return nil, "pstor_api_unavailable"
    end

    local actor = db.actor
    local id_ok, actor_id = pcall(function()
        return actor:id()
    end)
    if not id_ok or type(actor_id) ~= "number"
        or db.storage[actor_id] == nil then
        return nil, "actor_storage_unavailable"
    end
    return actor, nil
end

local function gpt_world_is_safe_catalog_id(entity_id)
    return type(entity_id) == "string"
        and string.match(entity_id, "^[%w:_]+$") ~= nil
end

local function gpt_world_read_persisted_place_ids()
    if GPT_WORLD_PERSISTENCE_SUSPENDED then
        return {}, nil
    end

    local actor, actor_error = gpt_world_get_actor_pstor()
    if actor == nil then
        return nil, actor_error
    end

    local read_ok, encoded = pcall(
        xr_logic.pstor_retrieve,
        actor,
        GPT_WORLD_PERSISTENCE_KEY,
        ""
    )
    if not read_ok then
        return nil, "pstor_read_failed"
    end
    if type(encoded) ~= "string" then
        return nil, "pstor_value_not_string"
    end

    local ids = {}
    local seen = {}
    for entity_id in string.gmatch(encoded, "([^|]+)") do
        if gpt_world_is_safe_catalog_id(entity_id)
            and not seen[entity_id]
            and gpt_world.get_catalog_entity(entity_id) ~= nil then
            seen[entity_id] = true
            ids[#ids + 1] = entity_id
        end
    end
    table.sort(ids)
    return ids, nil
end

local function gpt_world_persist_known_place(entity_id)
    if not gpt_world_is_safe_catalog_id(entity_id)
        or gpt_world.get_catalog_entity(entity_id) == nil then
        return false, "entity_not_catalogued"
    end

    local ids, read_error = gpt_world_read_persisted_place_ids()
    if ids == nil then
        return false, read_error
    end
    for _, existing_id in ipairs(ids) do
        if existing_id == entity_id then
            return true, nil
        end
    end
    if #ids >= GPT_WORLD_MAX_PERSISTED_PLACES then
        return false, "persistent_place_limit"
    end

    ids[#ids + 1] = entity_id
    table.sort(ids)
    local encoded = table.concat(ids, "|")
    local actor, actor_error = gpt_world_get_actor_pstor()
    if actor == nil then
        return false, actor_error
    end

    local write_ok = pcall(
        xr_logic.pstor_store,
        actor,
        GPT_WORLD_PERSISTENCE_KEY,
        encoded
    )
    if not write_ok then
        return false, "pstor_write_failed"
    end
    return true, nil
end

local function gpt_world_persisted_place_claim(entity_id)
    local catalog_record = gpt_world.get_catalog_entity(entity_id)
    if catalog_record == nil then
        return nil
    end

    local level_id = catalog_record.level_id
    if catalog_record.entity_type == "level" then
        level_id = entity_id
    end

    return {
        claim_id = "claim:pstor:" .. entity_id,
        subject_id = entity_id,
        level_id = level_id,
        predicate = "known_place",
        value = true,
        status = "observed",
        source_type = "observation",
        source_id = "actor_pstor_restore",
        confidence = 1,
        created_at = 0,
        last_confirmed_at = 0,
        persistence_backend = "actor_pstor"
    }
end

function gpt_world.get_persistence_status(entity_id)
    local ids, read_error = gpt_world_read_persisted_place_ids()
    if ids == nil then
        return {
            backend = "unavailable",
            persisted_place_count = 0,
            contains_entity = false,
            error = read_error
        }
    end

    local contains_entity = entity_id == nil
    if entity_id ~= nil then
        for _, persisted_id in ipairs(ids) do
            if persisted_id == entity_id then
                contains_entity = true
                break
            end
        end
    end

    return {
        backend = "actor_pstor",
        persisted_place_count = #ids,
        contains_entity = contains_entity
    }
end

-- Stores one explicit knowledge claim in the current Lua session.
-- Required fields: subject_id, predicate, value, status, source_type,
-- confidence (0..1), created_at (caller-supplied game-time value).
-- Returns: stored_claim, nil or nil, stable_error_code.
function gpt_world.record_claim(claim)
    if type(claim) ~= "table" then
        return nil, "claim_not_table"
    end
    if not gpt_world_is_nonempty_string(claim.subject_id) then
        return nil, "invalid_subject_id"
    end
    if type(claim.predicate) ~= "string" or claim.predicate == "" then
        return nil, "invalid_predicate"
    end
    if claim.value == nil or not gpt_world_is_claim_scalar(claim.value) then
        return nil, "invalid_claim_value"
    end
    if not GPT_WORLD_CLAIM_STATUSES[claim.status] then
        return nil, "invalid_claim_status"
    end
    if type(claim.source_type) ~= "string" or claim.source_type == "" then
        return nil, "invalid_source_type"
    end
    if claim.level_id ~= nil and not gpt_world_is_nonempty_string(claim.level_id) then
        return nil, "invalid_claim_level_id"
    end
    if type(claim.source_id) ~= "nil"
        and type(claim.source_id) ~= "string"
        and type(claim.source_id) ~= "number" then
        return nil, "invalid_source_id"
    end
    if type(claim.confidence) ~= "number"
        or claim.confidence < 0 or claim.confidence > 1 then
        return nil, "invalid_confidence"
    end
    if type(claim.created_at) ~= "number" or claim.created_at < 0 then
        return nil, "invalid_created_at"
    end
    if claim.last_confirmed_at ~= nil
        and (type(claim.last_confirmed_at) ~= "number" or claim.last_confirmed_at < 0) then
        return nil, "invalid_last_confirmed_at"
    end
    if #GPT_WORLD_CLAIMS >= GPT_WORLD_MAX_CLAIMS then
        return nil, "claim_store_full"
    end

    local persist_known_place =
        claim.predicate == "known_place"
        and claim.value == true
        and claim.status == "observed"
        and claim.source_type == "observation"
        and gpt_world.get_catalog_entity(claim.subject_id) ~= nil

    if persist_known_place then
        local persist_ok, persist_error =
            gpt_world_persist_known_place(claim.subject_id)
        if not persist_ok then
            return nil, "persistence_failed:" .. tostring(persist_error)
        end
    end

    local stored = {
        claim_id = "claim:" .. tostring(GPT_WORLD_NEXT_CLAIM_ID),
        subject_id = claim.subject_id,
        level_id = claim.level_id,
        predicate = claim.predicate,
        value = claim.value,
        status = claim.status,
        source_type = claim.source_type,
        source_id = claim.source_id,
        confidence = claim.confidence,
        created_at = claim.created_at,
        last_confirmed_at = claim.last_confirmed_at
    }

    if persist_known_place then
        stored.persistence_backend = "actor_pstor"
    end

    GPT_WORLD_NEXT_CLAIM_ID = GPT_WORLD_NEXT_CLAIM_ID + 1
    GPT_WORLD_CLAIMS[#GPT_WORLD_CLAIMS + 1] = stored
    return gpt_world_copy_claim(stored), nil
end

-- Returns copies only; callers cannot mutate the internal claim store.
-- Both filters are optional.
function gpt_world.get_claims(subject_id, predicate)
    if subject_id ~= nil and not gpt_world_is_nonempty_string(subject_id) then
        return {}
    end
    if predicate ~= nil and (type(predicate) ~= "string" or predicate == "") then
        return {}
    end

    local result = {}
    local seen = {}
    for _, claim in ipairs(GPT_WORLD_CLAIMS) do
        if (subject_id == nil or claim.subject_id == subject_id)
            and (predicate == nil or claim.predicate == predicate) then
            result[#result + 1] = gpt_world_copy_claim(claim)
            seen[tostring(claim.subject_id) .. "|" .. tostring(claim.predicate)] = true
        end
    end

    local persisted_ids = gpt_world_read_persisted_place_ids()
    if type(persisted_ids) == "table"
        and (predicate == nil or predicate == "known_place") then
        for _, entity_id in ipairs(persisted_ids) do
            local key = entity_id .. "|known_place"
            if (subject_id == nil or entity_id == subject_id)
                and not seen[key] then
                local persisted_claim = gpt_world_persisted_place_claim(entity_id)
                if persisted_claim ~= nil then
                    result[#result + 1] = persisted_claim
                end
            end
        end
    end
    return result
end

-- A place is returned only after an explicit positive known_place claim.
-- Catalog membership alone never creates a known place.
-- Optional filters.level_id limits results to a catalogued level.
function gpt_world.get_known_places(filters)
    if filters ~= nil and type(filters) ~= "table" then
        return {}
    end

    local level_filter = filters and filters.level_id or nil
    if level_filter ~= nil and not gpt_world_is_nonempty_string(level_filter) then
        return {}
    end

    local places_by_id = {}
    local all_claims = gpt_world.get_claims(nil, "known_place")
    for _, claim in ipairs(all_claims) do
        if claim.predicate == "known_place" then
            local place_id = claim.subject_id
            local include_place = true

            if level_filter ~= nil then
                if place_id == level_filter then
                    include_place = true
                else
                    local catalog_record = gpt_world.get_catalog_entity(place_id)
                    include_place = claim.level_id == level_filter
                        or (catalog_record ~= nil and catalog_record.level_id == level_filter)
                end
            end

            if include_place then
                local entry = places_by_id[place_id]
                if entry == nil then
                    local catalog_record = gpt_world.get_catalog_entity(place_id)
                    entry = {
                        entity_id = place_id,
                        level_id = claim.level_id
                            or (catalog_record and catalog_record.level_id) or nil,
                        claims = {},
                        known = false
                    }
                    if catalog_record ~= nil then
                        entry.catalog = {
                            entity_type = catalog_record.entity_type,
                            display_name = catalog_record.display_name,
                            category = catalog_record.category
                        }
                    end
                    places_by_id[place_id] = entry
                end

                entry.claims[#entry.claims + 1] = gpt_world_copy_claim(claim)
                if claim.value == true then
                    entry.known = true
                end
            end
        end
    end

    local result = {}
    for _, entry in pairs(places_by_id) do
        if entry.known then
            result[#result + 1] = entry
        end
    end

    table.sort(result, function(left, right)
        return left.entity_id < right.entity_id
    end)
    return result
end

-- Converts only an explicitly confirmed place-observation event into knowledge.
-- Required event fields: event_type="place_observed", confirmed=true,
-- entity_id, source_id and created_at. No world scanning is performed here.
function gpt_world.record_observation(event)
    if type(event) ~= "table" then
        return nil, "event_not_table"
    end
    if event.event_type ~= "place_observed" then
        return nil, "unsupported_observation_event"
    end
    if event.confirmed ~= true then
        return nil, "observation_not_confirmed"
    end
    if not gpt_world_is_nonempty_string(event.entity_id) then
        return nil, "invalid_observed_entity_id"
    end
    if event.level_id ~= nil and not gpt_world_is_nonempty_string(event.level_id) then
        return nil, "invalid_observation_level_id"
    end
    if type(event.source_id) ~= "string" and type(event.source_id) ~= "number" then
        return nil, "invalid_observation_source_id"
    end
    if type(event.created_at) ~= "number" or event.created_at < 0 then
        return nil, "invalid_observation_time"
    end

    local confidence = event.confidence
    if confidence == nil then
        confidence = 1
    end

    return gpt_world.record_claim({
        subject_id = event.entity_id,
        level_id = event.level_id,
        predicate = "known_place",
        value = true,
        status = "observed",
        source_type = "observation",
        source_id = event.source_id,
        confidence = confidence,
        created_at = event.created_at,
        last_confirmed_at = event.created_at
    })
end

-- Gives future dialogue/agent code a single envelope while keeping objective
-- engine state and character knowledge in separate named fields.
-- Knowledge includes only explicit claims; it is not inferred from the catalog.
function gpt_world.get_companion_world_context(companion_alife_id, snapshot_override)
    local snapshot = snapshot_override
    local snapshot_error = nil
    if type(snapshot) ~= "table"
        or snapshot.source ~= "xray_alife_snapshot"
        or (companion_alife_id ~= nil
            and snapshot.companion_alife_object_id ~= companion_alife_id) then
        snapshot, snapshot_error =
            gpt_world.get_companion_location_snapshot(companion_alife_id)
    end
    if snapshot == nil then
        return nil, snapshot_error
    end

    local level_id = snapshot.level and snapshot.level.entity_id or nil
    local known_places = gpt_world.get_known_places({
        level_id = level_id
    })
    local all_known_places = gpt_world.get_known_places()
    local persistence_status = gpt_world.get_persistence_status(level_id)

    return {
        engine = snapshot,
        knowledge = {
            known_places = known_places,
            all_known_places = all_known_places,
            persistence = persistence_status.backend,
            persisted_place_count = persistence_status.persisted_place_count,
            current_level_persisted = persistence_status.contains_entity == true
        },
        source = "gpt_world_context"
    }, nil
end

-- Records a real online A-Life snapshot as observed geographic knowledge.
-- A level counts as visited only while the companion is actually online there.
-- Assigned Smart Terrain is recorded only when the snapshot resolves a catalog entry.
function gpt_world.record_companion_location_observation(snapshot, observed_at)
    if type(snapshot) ~= "table"
        or snapshot.source ~= "xray_alife_snapshot"
        or snapshot.companion_story_id ~= GPT_WORLD_COMPANION_STORY_ID then
        return nil, "invalid_engine_snapshot"
    end
    if snapshot.is_online ~= true then
        return nil, "companion_not_online"
    end
    if type(observed_at) ~= "number" or observed_at < 0 then
        return nil, "invalid_observation_time"
    end

    local level_id = snapshot.level and snapshot.level.entity_id or nil
    local level_record = type(level_id) == "string"
        and gpt_world.get_catalog_entity(level_id) or nil
    if type(level_record) ~= "table" or level_record.entity_type ~= "level" then
        return nil, "level_not_catalogued"
    end

    local source_id = snapshot.companion_alife_object_id
    if type(source_id) ~= "number" then
        return nil, "companion_source_id_unavailable"
    end

    local recorded = {}
    local function observe_once(entity_id, entity_level_id)
        local existing = gpt_world.get_claims(entity_id, "known_place")
        for _, claim in ipairs(existing) do
            if claim.value == true then
                local persist_ok, persist_error =
                    gpt_world_persist_known_place(entity_id)
                if not persist_ok then
                    return false, false, persist_error
                end
                return true, false, nil
            end
        end

        local claim, observation_error = gpt_world.record_observation({
            event_type = "place_observed",
            confirmed = true,
            entity_id = entity_id,
            level_id = entity_level_id,
            source_id = source_id,
            created_at = observed_at,
            confidence = 1
        })
        if claim == nil then
            return false, false, observation_error
        end
        recorded[#recorded + 1] = claim
        return true, true, nil
    end

    local level_ok, level_new, level_error = observe_once(level_id, level_id)
    if not level_ok then
        return nil, "level_observation_failed:" .. tostring(level_error)
    end

    local save_restore_checked = false
    local save_restore_verified = false
    if GPT_WORLD_PENDING_SAVE_RESTORE_CHECK then
        local restored_status = gpt_world.get_persistence_status(level_id)
        save_restore_checked = true
        save_restore_verified = level_new == false
            and restored_status.backend == "actor_pstor"
            and restored_status.contains_entity == true
        GPT_WORLD_PENDING_SAVE_RESTORE_CHECK = false
    end

    local smart_terrain_id = nil
    local smart_terrain = snapshot.smart_terrain
    if type(smart_terrain) == "table"
        and type(smart_terrain.entity_id) == "string" then
        local smart_record = gpt_world.get_catalog_entity(smart_terrain.entity_id)
        if type(smart_record) == "table"
            and smart_record.level_id == level_id then
            local smart_ok, smart_new, smart_error =
                observe_once(smart_terrain.entity_id, level_id)
            if not smart_ok then
                return nil, "smart_terrain_observation_failed:" .. tostring(smart_error)
            end
            smart_terrain_id = smart_terrain.entity_id
        end
    end

    local persistence_status = gpt_world.get_persistence_status(level_id)
    local known_places = gpt_world.get_known_places({
        level_id = level_id
    })
    local current_level_known = false
    local current_smart_terrain_known = smart_terrain_id == nil
    for _, place in ipairs(known_places) do
        if place.entity_id == level_id and place.known == true then
            current_level_known = true
        end
        if smart_terrain_id ~= nil
            and place.entity_id == smart_terrain_id and place.known == true then
            current_smart_terrain_known = true
        end
    end

    if not current_level_known then
        return nil, "level_not_returned_by_knowledge_query"
    end
    if not current_smart_terrain_known then
        return nil, "smart_terrain_not_returned_by_knowledge_query"
    end
    if persistence_status.backend ~= "actor_pstor"
        or persistence_status.contains_entity ~= true then
        return nil, "current_level_not_persisted:"
            .. tostring(persistence_status.error or persistence_status.backend)
    end
    if smart_terrain_id ~= nil then
        local smart_persistence = gpt_world.get_persistence_status(smart_terrain_id)
        if smart_persistence.backend ~= "actor_pstor"
            or smart_persistence.contains_entity ~= true then
            return nil, "current_smart_terrain_not_persisted"
        end
    end
    return {
        snapshot = snapshot,
        current_level_id = level_id,
        current_smart_terrain_id = smart_terrain_id,
        observations = recorded,
        current_level_known = current_level_known,
        current_smart_terrain_known = current_smart_terrain_known,
        persistence_backend = persistence_status.backend,
        persisted_place_count = persistence_status.persisted_place_count,
        save_restore_checked = save_restore_checked,
        save_restore_verified = save_restore_verified,
        already_known = #recorded == 0
    }, nil
end

-- Called immediately after actor_binder restores PSTOR from a save.
-- Drop Lua-session claims so the save-backed list is the sole authority after load.
function gpt_world.reset_session_after_actor_load()
    GPT_WORLD_CLAIMS = {}
    GPT_WORLD_NEXT_CLAIM_ID = 1
    GPT_WORLD_PERSISTENCE_SUSPENDED = false
    GPT_WORLD_PENDING_SAVE_RESTORE_CHECK = true
    return true
end

-- Runs the public knowledge API against an isolated temporary claim table.
-- The caller's in-session claims and claim ID sequence are restored even if
-- an assertion or the live engine context read fails.
function gpt_world.run_knowledge_api_self_test(companion_alife_id, test_level_id_override)
    local result = {
        claim_write_ok = false,
        claim_read_ok = false,
        known_places_ok = false,
        observation_ok = false,
        unconfirmed_observation_rejected_ok = false,
        poi_catalog_ok = false,
        provenance_ok = false,
        context_ok = false,
        context_skipped = false,
        probe_passed = false
    }

    local test_level_id = nil
    if gpt_world_is_nonempty_string(test_level_id_override) then
        -- Core storage tests can run as soon as the module loads; they do not
        -- depend on a live companion or the A-Life snapshot path.
        test_level_id = test_level_id_override
    elseif companion_alife_id ~= nil then
        local initial_snapshot, initial_snapshot_error =
            gpt_world.get_companion_location_snapshot(companion_alife_id)
        if type(initial_snapshot) ~= "table"
            or type(initial_snapshot.level) ~= "table"
            or type(initial_snapshot.level.entity_id) ~= "string" then
            result.error = "engine_snapshot_unavailable:" .. tostring(initial_snapshot_error)
            return result, "self_test_engine_snapshot_unavailable"
        end
        test_level_id = initial_snapshot.level.entity_id
    else
        result.error = "test_level_id_required_without_companion"
        return result, "self_test_missing_test_level"
    end

    local previous_claims = GPT_WORLD_CLAIMS
    local previous_next_claim_id = GPT_WORLD_NEXT_CLAIM_ID
    local previous_persistence_suspended = GPT_WORLD_PERSISTENCE_SUSPENDED
    GPT_WORLD_PERSISTENCE_SUSPENDED = true
    GPT_WORLD_CLAIMS = {}
    GPT_WORLD_NEXT_CLAIM_ID = 1

    local run_ok, run_error = pcall(function()
        local initially_known_places = gpt_world.get_known_places()
        if type(initially_known_places) ~= "table" or #initially_known_places ~= 0 then
            error("catalog_entries_leaked_into_knowledge")
        end

        local skadovsk_catalog = gpt_world.get_catalog_entity("poi:zaton:skadovsk")
        local zaton_pois = gpt_world.get_catalog_pois("level:zaton")
        local has_skadovsk = false
        for _, poi in ipairs(zaton_pois) do
            if poi.entity_id == "poi:zaton:skadovsk"
                and poi.anchor_entity_id == "smart:zaton:zat_stalker_base_smart" then
                has_skadovsk = true
            end
        end
        if type(skadovsk_catalog) ~= "table"
            or skadovsk_catalog.entity_type ~= "poi"
            or skadovsk_catalog.level_id ~= "level:zaton"
            or type(zaton_pois) ~= "table" or #zaton_pois ~= 5
            or not has_skadovsk then
            error("poi_catalog_lookup_mismatch")
        end
        result.poi_catalog_ok = true

        local claim, claim_error = gpt_world.record_claim({
            subject_id = "poi:gpt_world_self_test:claim",
            level_id = test_level_id,
            predicate = "known_place",
            value = true,
            status = "observed",
            source_type = "self_test",
            source_id = "gpt_world_self_test",
            confidence = 1,
            created_at = 1,
            last_confirmed_at = 1
        })
        if claim == nil then
            error("claim_write:" .. tostring(claim_error))
        end
        if claim.claim_id ~= "claim:1"
            or claim.subject_id ~= "poi:gpt_world_self_test:claim"
            or claim.level_id ~= test_level_id
            or claim.confidence ~= 1 then
            error("claim_write_result_invalid")
        end
        result.claim_write_ok = true

        local claims = gpt_world.get_claims(
            "poi:gpt_world_self_test:claim",
            "known_place"
        )
        if type(claims) ~= "table" or #claims ~= 1
            or claims[1].claim_id ~= claim.claim_id
            or claims[1].value ~= true then
            error("claim_read_mismatch")
        end

        -- Mutating returned data must not modify the internal store.
        claims[1].value = false
        local claims_again = gpt_world.get_claims(
            "poi:gpt_world_self_test:claim",
            "known_place"
        )
        if #claims_again ~= 1 or claims_again[1].value ~= true then
            error("claim_copy_is_not_isolated")
        end
        result.claim_read_ok = true

        local current_level_places = gpt_world.get_known_places({
            level_id = test_level_id
        })
        local jupiter_places = gpt_world.get_known_places({
            level_id = "level:gpt_world_self_test_other"
        })
        if type(current_level_places) ~= "table" or #current_level_places ~= 1
            or current_level_places[1].entity_id ~= "poi:gpt_world_self_test:claim"
            or type(jupiter_places) ~= "table" or #jupiter_places ~= 0 then
            error("known_places_level_filter_mismatch")
        end
        result.known_places_ok = true

        local observation, observation_error = gpt_world.record_observation({
            event_type = "place_observed",
            confirmed = true,
            entity_id = "poi:gpt_world_self_test:observation",
            level_id = test_level_id,
            source_id = "gpt_world_self_test_event",
            created_at = 2,
            confidence = 0.95
        })
        if observation == nil then
            error("observation_write:" .. tostring(observation_error))
        end
        if observation.status ~= "observed"
            or observation.predicate ~= "known_place"
            or observation.source_type ~= "observation" then
            error("observation_result_invalid")
        end
        result.observation_ok = true

        -- Reported and inferred POI claims remain session-only in this MVP.
        -- They must not be promoted to observed facts or written to PSTOR.
        local reported_poi, reported_error = gpt_world.record_claim({
            subject_id = "poi:zaton:skadovsk",
            level_id = "level:zaton",
            predicate = "known_place",
            value = true,
            status = "reported",
            source_type = "conversation",
            source_id = "gpt_world_self_test_npc",
            confidence = 0.75,
            created_at = 2.5,
            last_confirmed_at = 2.5
        })
        if reported_poi == nil or reported_poi.status ~= "reported"
            or reported_poi.source_type ~= "conversation"
            or reported_poi.persistence_backend ~= nil then
            error("reported_poi_claim_invalid:" .. tostring(reported_error))
        end

        local inferred_poi, inferred_error = gpt_world.record_claim({
            subject_id = "poi:zaton:ranger_station",
            level_id = "level:zaton",
            predicate = "known_place",
            value = true,
            status = "inferred",
            source_type = "reasoning",
            source_id = "gpt_world_self_test_reasoning",
            confidence = 0.55,
            created_at = 2.75
        })
        if inferred_poi == nil or inferred_poi.status ~= "inferred"
            or inferred_poi.source_type ~= "reasoning"
            or inferred_poi.persistence_backend ~= nil then
            error("inferred_poi_claim_invalid:" .. tostring(inferred_error))
        end

        local reported_poi_places = gpt_world.get_known_places({
            level_id = "level:zaton"
        })
        local reported_poi_has_metadata = false
        for _, place in ipairs(reported_poi_places) do
            if place.entity_id == "poi:zaton:skadovsk"
                and place.catalog ~= nil
                and place.catalog.display_name == "Скадовск"
                and place.claims[1] ~= nil
                and place.claims[1].status == "reported" then
                reported_poi_has_metadata = true
            end
        end
        if not reported_poi_has_metadata then
            error("reported_poi_metadata_missing")
        end
        result.provenance_ok = true

        local rejected, reject_error = gpt_world.record_observation({
            event_type = "place_observed",
            confirmed = false,
            entity_id = "poi:gpt_world_self_test:unconfirmed",
            level_id = test_level_id,
            source_id = "gpt_world_self_test_event",
            created_at = 3
        })
        if rejected ~= nil or reject_error ~= "observation_not_confirmed" then
            error("unconfirmed_observation_was_not_rejected")
        end
        local unconfirmed_claims = gpt_world.get_claims(
            "poi:gpt_world_self_test:unconfirmed",
            "known_place"
        )
        if #unconfirmed_claims ~= 0 then
            error("unconfirmed_observation_created_claim")
        end
        result.unconfirmed_observation_rejected_ok = true

        if companion_alife_id ~= nil then
            local context, context_error =
                gpt_world.get_companion_world_context(companion_alife_id)
            if type(context) ~= "table" or type(context.engine) ~= "table"
                or type(context.engine.level) ~= "table"
                or type(context.engine.level.entity_id) ~= "string" then
                error("world_context_unavailable:" .. tostring(context_error))
            end
            if context.engine.level.entity_id ~= test_level_id then
                error("world_context_level_mismatch")
            end
            if context.engine.is_online ~= true then
                error("world_context_companion_not_online")
            end
            if type(context.knowledge) ~= "table"
                or context.knowledge.persistence ~= "session_only"
                or type(context.knowledge.known_places) ~= "table"
                or #context.knowledge.known_places
                    ~= (test_level_id == "level:zaton" and 4 or 2) then
                error("world_context_knowledge_mismatch")
            end
            result.context_level_entity_id = context.engine.level.entity_id
            result.context_is_online = context.engine.is_online == true
            result.context_ok = true
        else
            -- The engine-backed context is checked separately after a real
            -- companion online snapshot becomes available.
            result.context_skipped = true
        end
        result.test_level_entity_id = test_level_id
    end)

    -- Always restore caller data and IDs; self-test leaves no test claims.
    GPT_WORLD_CLAIMS = previous_claims
    GPT_WORLD_NEXT_CLAIM_ID = previous_next_claim_id
    GPT_WORLD_PERSISTENCE_SUSPENDED = previous_persistence_suspended

    if not run_ok then
        result.error = tostring(run_error)
        return result, "self_test_failed"
    end

    result.probe_passed = result.claim_write_ok
        and result.claim_read_ok
        and result.known_places_ok
        and result.observation_ok
        and result.unconfirmed_observation_rejected_ok
        and result.poi_catalog_ok
        and result.provenance_ok
        and (result.context_ok or result.context_skipped)

    if not result.probe_passed then
        return result, "self_test_assertion_failed"
    end
    return result, nil
end
