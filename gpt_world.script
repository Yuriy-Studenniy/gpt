local function gpt_world_copy_record(record)
    if type(record) ~= "table" then
        return nil
    end

    local copy = {}
    for key, value in pairs(record) do
        if type(value) == "table" then
            local nested = {}
            for nested_key, nested_value in pairs(value) do
                nested[nested_key] = nested_value
            end
            copy[key] = nested
        else
            copy[key] = value
        end
    end
    return copy
end

-- Static catalog lookup. Catalog presence must never be treated as
-- evidence that the companion knows or has visited the location.
function gpt_world.get_catalog_entity(entity_id)
    if type(entity_id) ~= "string" then
        return nil
    end

    local record = GPT_WORLD_LEVEL_CATALOG[entity_id]
        or GPT_WORLD_SMART_TERRAIN_CATALOG[entity_id]
    return gpt_world_copy_record(record)
end

-- Returns a fresh array of static Smart Terrain descriptors. Passing nil
-- returns all catalogued entries; a level entity ID filters the result.
function gpt_world.get_catalog_smart_terrains(level_entity_id)
    if level_entity_id ~= nil and type(level_entity_id) ~= "string" then
        return {}
    end

    local result = {}
    for _, record in pairs(GPT_WORLD_SMART_TERRAIN_CATALOG) do
        if level_entity_id == nil or record.level_id == level_entity_id then
            result[#result + 1] = gpt_world_copy_record(record)
        end
    end

    table.sort(result, function(left, right)
        return left.entity_id < right.entity_id
    end)

    return result
end

-- Returns a fresh array of static level descriptors.
-- It is intentionally separate from the companion's known-place queries.
function gpt_world.get_catalog_levels()
    local result = {}
    for entity_id, record in pairs(GPT_WORLD_LEVEL_CATALOG) do
        result[#result + 1] = gpt_world_copy_record(record)
    end

    table.sort(result, function(left, right)
        return left.entity_id < right.entity_id
    end)

    return result
end

local function gpt_world_safe_index(object, field_name)
    if object == nil then
        return nil
    end

    local ok, value = pcall(function()
        return object[field_name]
    end)

    if ok then
        return value
    end

    return nil
end

local function gpt_world_safe_method(object, method_name, ...)
    local method = gpt_world_safe_index(object, method_name)
    if type(method) ~= "function" then
        return nil
    end

    local ok, value = pcall(method, object, ...)
    if ok then
        return value
    end

    return nil
end

local function gpt_world_get_alife()
    if type(alife) ~= "function" then
        return nil
    end

    local ok, simulation = pcall(alife)
    if ok then
        return simulation
    end

    return nil
end

local function gpt_world_get_game_graph()
    if type(game_graph) ~= "function" then
        return nil
    end

    local ok, graph = pcall(game_graph)
    if ok then
        return graph
    end

    return nil
end

local function gpt_world_get_companion_server_object(simulation, requested_companion_id)
    -- Callers that already hold the A-Life ID can avoid depending on the
    -- Story ID registry having been refreshed at this exact update.
    if requested_companion_id ~= nil then
        if type(requested_companion_id) ~= "number" or requested_companion_id <= 0 then
            return nil, "invalid_companion_id"
        end

        local requested_companion = gpt_world_safe_method(simulation, "object", requested_companion_id)
        if requested_companion == nil then
            return nil, "companion_object_unavailable"
        end

        return requested_companion, requested_companion_id
    end

    if type(get_story_object_id) ~= "function" then
        return nil, "story_id_lookup_unavailable"
    end

    local ok, companion_id = pcall(get_story_object_id, GPT_WORLD_COMPANION_STORY_ID)
    if not ok then
        return nil, "story_id_lookup_failed"
    end
    if type(companion_id) ~= "number" then
        return nil, "companion_not_registered"
    end

    local companion = gpt_world_safe_method(simulation, "object", companion_id)
    if companion == nil then
        return nil, "companion_object_unavailable"
    end

    return companion, companion_id
end

local function gpt_world_get_online_companion_object(companion_id)
    if type(db) ~= "table" then
        return nil
    end

    local storage = gpt_world_safe_index(db, "storage")
    local companion_storage = gpt_world_safe_index(storage, companion_id)
    return gpt_world_safe_index(companion_storage, "object")
end

local function gpt_world_get_game_vertex_id(companion)
    local game_vertex_id = gpt_world_safe_index(companion, "m_game_vertex_id")
    if type(game_vertex_id) == "number" then
        return game_vertex_id
    end

    game_vertex_id = gpt_world_safe_method(companion, "game_vertex_id")
    if type(game_vertex_id) == "number" then
        return game_vertex_id
    end

    return nil
end

local function gpt_world_resolve_level(simulation, graph, game_vertex_id)
    if type(game_vertex_id) ~= "number" then
        return nil
    end

    local vertex = gpt_world_safe_method(graph, "vertex", game_vertex_id)
    if vertex == nil then
        return nil
    end

    local level_id = gpt_world_safe_method(vertex, "level_id")
    if type(level_id) ~= "number" then
        return nil
    end

    local level_name = gpt_world_safe_method(simulation, "level_name", level_id)
    if type(level_name) ~= "string" or level_name == "" then
        return nil
    end

    return {
        entity_id = "level:" .. level_name,
        name = level_name,
        game_graph_level_id = level_id,
        game_vertex_id = game_vertex_id
    }
end

local function gpt_world_resolve_smart_terrain(simulation, server_companion, online_companion, level_name)
    local smart_terrain_id = gpt_world_safe_index(online_companion, "m_smart_terrain_id")
    if type(smart_terrain_id) ~= "number" then
        smart_terrain_id = gpt_world_safe_index(server_companion, "m_smart_terrain_id")
    end

    if type(smart_terrain_id) ~= "number" then
        return nil, "smart_terrain_id_unavailable", nil
    end
    if smart_terrain_id == GPT_WORLD_NO_SMART_TERRAIN_ID or smart_terrain_id <= 0 then
        return nil, "no_smart_terrain_assigned", smart_terrain_id
    end

    local smart_terrain = gpt_world_safe_method(simulation, "object", smart_terrain_id)
    if smart_terrain == nil then
        return nil, "smart_terrain_object_unavailable", smart_terrain_id
    end

    local smart_terrain_name = gpt_world_safe_method(smart_terrain, "name")
    if type(smart_terrain_name) ~= "string" or smart_terrain_name == "" then
        return nil, "smart_terrain_name_unavailable", smart_terrain_id
    end

    local parent_level = level_name
    if type(parent_level) ~= "string" or parent_level == "" then
        parent_level = "unknown"
    end

    return {
        entity_id = "smart:" .. parent_level .. ":" .. smart_terrain_name,
        name = smart_terrain_name,
        alife_object_id = smart_terrain_id
    }, "resolved", smart_terrain_id
end

-- Returns objective engine context only.
-- The returned table is not the companion's knowledge and must not be sent
-- directly to dialogue/LLM as a list of places the character knows.
--
-- Success:
--   snapshot, nil
-- Failure:
--   nil, stable_error_code
-- Pass companion_alife_id when the caller already has a current A-Life
-- object ID. With no argument, resolve the unique companion through Story ID.
function gpt_world.get_companion_location_snapshot(companion_alife_id)
    local simulation = gpt_world_get_alife()
    if simulation == nil then
        return nil, "alife_unavailable"
    end

    local companion, companion_id = gpt_world_get_companion_server_object(simulation, companion_alife_id)
    if companion == nil then
        return nil, companion_id
    end

    -- The online object exposes the live game vertex. The server-side
    -- A-Life object is the fallback for an offline companion.
    local online_companion = gpt_world_get_online_companion_object(companion_id)
    local runtime_companion = online_companion or companion
    local game_vertex_id = gpt_world_get_game_vertex_id(runtime_companion)
    if game_vertex_id == nil and runtime_companion ~= companion then
        game_vertex_id = gpt_world_get_game_vertex_id(companion)
    end
    if game_vertex_id == nil then
        return nil, "companion_game_vertex_unavailable"
    end

    local graph = gpt_world_get_game_graph()
    if graph == nil then
        return nil, "game_graph_unavailable"
    end

    local level = gpt_world_resolve_level(simulation, graph, game_vertex_id)
    if level == nil then
        return nil, "companion_level_unavailable"
    end

    local smart_terrain, smart_terrain_status, smart_terrain_id = gpt_world_resolve_smart_terrain(
        simulation,
        companion,
        online_companion,
        level.name
    )

    return {
        companion_story_id = GPT_WORLD_COMPANION_STORY_ID,
        companion_alife_object_id = companion_id,
        is_online = online_companion ~= nil,
        level = level,
        smart_terrain = smart_terrain,
        smart_terrain_status = smart_terrain_status,
        smart_terrain_alife_object_id = smart_terrain_id,
        source = "xray_alife_snapshot"
    }, nil
end


-- Companion knowledge is deliberately separate from the engine snapshot and
-- static catalog. This first backend is session-only until save compatibility
-- for the companion A-Life squad has been audited.
local GPT_WORLD_CLAIMS = {}
local GPT_WORLD_NEXT_CLAIM_ID = 1
local GPT_WORLD_MAX_CLAIMS = 512

local GPT_WORLD_CLAIM_STATUSES = {
    observed = true,
    reported = true,
    inferred = true
}

local function gpt_world_is_nonempty_string(value)
    return type(value) == "string" and value ~= ""
        and string.find(value, ":", 1, true) ~= nil
end

local function gpt_world_is_claim_scalar(value)
    local value_type = type(value)
    return value_type == "string" or value_type == "number" or value_type == "boolean"
end

local function gpt_world_copy_claim(claim)
    if type(claim) ~= "table" then
        return nil
    end

    local copy = {}
    for key, value in pairs(claim) do
        if type(value) ~= "table" then
            copy[key] = value
        end
    end
    return copy
end

-- Stores one explicit knowledge claim in the current Lua session.
-- Required fields: subject_id, predicate, value, status, source_type,
-- confidence (0..1), created_at (caller-supplied game-time value).
-- Returns: stored_claim, nil or nil, stable_error_code.
function gpt_world.record_claim(claim)
    if type(claim) ~= "table" then
        return nil, "claim_not_table"
    end
    if not gpt_world_is_nonempty_string(claim.subject_id) then
        return nil, "invalid_subject_id"
    end
    if type(claim.predicate) ~= "string" or claim.predicate == "" then
        return nil, "invalid_predicate"
    end
    if claim.value == nil or not gpt_world_is_claim_scalar(claim.value) then
        return nil, "invalid_claim_value"
    end
    if not GPT_WORLD_CLAIM_STATUSES[claim.status] then
        return nil, "invalid_claim_status"
    end
    if type(claim.source_type) ~= "string" or claim.source_type == "" then
        return nil, "invalid_source_type"
    end
    if claim.level_id ~= nil and not gpt_world_is_nonempty_string(claim.level_id) then
        return nil, "invalid_claim_level_id"
    end
    if type(claim.source_id) ~= "nil"
        and type(claim.source_id) ~= "string"
        and type(claim.source_id) ~= "number" then
        return nil, "invalid_source_id"
    end
    if type(claim.confidence) ~= "number"
        or claim.confidence < 0 or claim.confidence > 1 then
        return nil, "invalid_confidence"
    end
    if type(claim.created_at) ~= "number" or claim.created_at < 0 then
        return nil, "invalid_created_at"
    end
    if claim.last_confirmed_at ~= nil
        and (type(claim.last_confirmed_at) ~= "number" or claim.last_confirmed_at < 0) then
        return nil, "invalid_last_confirmed_at"
    end
    if #GPT_WORLD_CLAIMS >= GPT_WORLD_MAX_CLAIMS then
        return nil, "claim_store_full"
    end

    local stored = {
        claim_id = "claim:" .. tostring(GPT_WORLD_NEXT_CLAIM_ID),
        subject_id = claim.subject_id,
        level_id = claim.level_id,
        predicate = claim.predicate,
        value = claim.value,
        status = claim.status,
        source_type = claim.source_type,
        source_id = claim.source_id,
        confidence = claim.confidence,
        created_at = claim.created_at,
        last_confirmed_at = claim.last_confirmed_at
    }

    GPT_WORLD_NEXT_CLAIM_ID = GPT_WORLD_NEXT_CLAIM_ID + 1
    GPT_WORLD_CLAIMS[#GPT_WORLD_CLAIMS + 1] = stored
    return gpt_world_copy_claim(stored), nil
end

-- Returns copies only; callers cannot mutate the internal claim store.
-- Both filters are optional.
function gpt_world.get_claims(subject_id, predicate)
    if subject_id ~= nil and not gpt_world_is_nonempty_string(subject_id) then
        return {}
    end
    if predicate ~= nil and (type(predicate) ~= "string" or predicate == "") then
        return {}
    end

    local result = {}
    for _, claim in ipairs(GPT_WORLD_CLAIMS) do
        if (subject_id == nil or claim.subject_id == subject_id)
            and (predicate == nil or claim.predicate == predicate) then
            result[#result + 1] = gpt_world_copy_claim(claim)
        end
    end
    return result
end

-- A place is returned only after an explicit positive known_place claim.
-- Catalog membership alone never creates a known place.
-- Optional filters.level_id limits results to a catalogued level.
function gpt_world.get_known_places(filters)
    if filters ~= nil and type(filters) ~= "table" then
        return {}
    end

    local level_filter = filters and filters.level_id or nil
    if level_filter ~= nil and not gpt_world_is_nonempty_string(level_filter) then
        return {}
    end

    local places_by_id = {}
    for _, claim in ipairs(GPT_WORLD_CLAIMS) do
        if claim.predicate == "known_place" then
            local place_id = claim.subject_id
            local include_place = true

            if level_filter ~= nil then
                if place_id == level_filter then
                    include_place = true
                else
                    local catalog_record = gpt_world.get_catalog_entity(place_id)
                    include_place = claim.level_id == level_filter
                        or (catalog_record ~= nil and catalog_record.level_id == level_filter)
                end
            end

            if include_place then
                local entry = places_by_id[place_id]
                if entry == nil then
                    entry = {
                        entity_id = place_id,
                        claims = {},
                        known = false
                    }
                    places_by_id[place_id] = entry
                end

                entry.claims[#entry.claims + 1] = gpt_world_copy_claim(claim)
                if claim.value == true then
                    entry.known = true
                end
            end
        end
    end

    local result = {}
    for _, entry in pairs(places_by_id) do
        if entry.known then
            result[#result + 1] = entry
        end
    end

    table.sort(result, function(left, right)
        return left.entity_id < right.entity_id
    end)
    return result
end

-- Converts only an explicitly confirmed place-observation event into knowledge.
-- Required event fields: event_type="place_observed", confirmed=true,
-- entity_id, source_id and created_at. No world scanning is performed here.
function gpt_world.record_observation(event)
    if type(event) ~= "table" then
        return nil, "event_not_table"
    end
    if event.event_type ~= "place_observed" then
        return nil, "unsupported_observation_event"
    end
    if event.confirmed ~= true then
        return nil, "observation_not_confirmed"
    end
    if not gpt_world_is_nonempty_string(event.entity_id) then
        return nil, "invalid_observed_entity_id"
    end
    if event.level_id ~= nil and not gpt_world_is_nonempty_string(event.level_id) then
        return nil, "invalid_observation_level_id"
    end
    if type(event.source_id) ~= "string" and type(event.source_id) ~= "number" then
        return nil, "invalid_observation_source_id"
    end
    if type(event.created_at) ~= "number" or event.created_at < 0 then
        return nil, "invalid_observation_time"
    end

    local confidence = event.confidence
    if confidence == nil then
        confidence = 1
    end

    return gpt_world.record_claim({
        subject_id = event.entity_id,
        level_id = event.level_id,
        predicate = "known_place",
        value = true,
        status = "observed",
        source_type = "observation",
        source_id = event.source_id,
        confidence = confidence,
        created_at = event.created_at,
        last_confirmed_at = event.created_at
    })
end

-- Gives future dialogue/agent code a single envelope while keeping objective
-- engine state and character knowledge in separate named fields.
-- Knowledge includes only explicit claims; it is not inferred from the catalog.
function gpt_world.get_companion_world_context(companion_alife_id)
    local snapshot, snapshot_error =
        gpt_world.get_companion_location_snapshot(companion_alife_id)
    if snapshot == nil then
        return nil, snapshot_error
    end

    local level_id = snapshot.level and snapshot.level.entity_id or nil
    local known_places = gpt_world.get_known_places({
        level_id = level_id
    })

    return {
        engine = snapshot,
        knowledge = {
            known_places = known_places,
            persistence = "session_only"
        },
        source = "gpt_world_context"
    }, nil
end

-- Runs the public knowledge API against an isolated temporary claim table.
-- The caller's in-session claims and claim ID sequence are restored even if
-- an assertion or the live engine context read fails.
function gpt_world.run_knowledge_api_self_test(companion_alife_id)
    local result = {
        claim_write_ok = false,
        claim_read_ok = false,
        known_places_ok = false,
        observation_ok = false,
        unconfirmed_observation_rejected_ok = false,
        context_ok = false,
        probe_passed = false
    }

    local initial_snapshot, initial_snapshot_error =
        gpt_world.get_companion_location_snapshot(companion_alife_id)
    if type(initial_snapshot) ~= "table"
        or type(initial_snapshot.level) ~= "table"
        or type(initial_snapshot.level.entity_id) ~= "string" then
        result.error = "engine_snapshot_unavailable:" .. tostring(initial_snapshot_error)
        return result, "self_test_engine_snapshot_unavailable"
    end
    local test_level_id = initial_snapshot.level.entity_id

    local previous_claims = GPT_WORLD_CLAIMS
    local previous_next_claim_id = GPT_WORLD_NEXT_CLAIM_ID
    GPT_WORLD_CLAIMS = {}
    GPT_WORLD_NEXT_CLAIM_ID = 1

    local run_ok, run_error = pcall(function()
        local claim, claim_error = gpt_world.record_claim({
            subject_id = "poi:gpt_world_self_test:claim",
            level_id = test_level_id,
            predicate = "known_place",
            value = true,
            status = "observed",
            source_type = "self_test",
            source_id = "gpt_world_self_test",
            confidence = 1,
            created_at = 1,
            last_confirmed_at = 1
        })
        if claim == nil then
            error("claim_write:" .. tostring(claim_error))
        end
        if claim.claim_id ~= "claim:1"
            or claim.subject_id ~= "poi:gpt_world_self_test:claim"
            or claim.level_id ~= "level:zaton"
            or claim.confidence ~= 1 then
            error("claim_write_result_invalid")
        end
        result.claim_write_ok = true

        local claims = gpt_world.get_claims(
            "poi:gpt_world_self_test:claim",
            "known_place"
        )
        if type(claims) ~= "table" or #claims ~= 1
            or claims[1].claim_id ~= claim.claim_id
            or claims[1].value ~= true then
            error("claim_read_mismatch")
        end

        -- Mutating returned data must not modify the internal store.
        claims[1].value = false
        local claims_again = gpt_world.get_claims(
            "poi:gpt_world_self_test:claim",
            "known_place"
        )
        if #claims_again ~= 1 or claims_again[1].value ~= true then
            error("claim_copy_is_not_isolated")
        end
        result.claim_read_ok = true

        local zaton_places = gpt_world.get_known_places({
            level_id = test_level_id
        })
        local jupiter_places = gpt_world.get_known_places({
            level_id = "level:gpt_world_self_test_other"
        })
        if type(zaton_places) ~= "table" or #zaton_places ~= 1
            or zaton_places[1].entity_id ~= "poi:gpt_world_self_test:claim"
            or type(jupiter_places) ~= "table" or #jupiter_places ~= 0 then
            error("known_places_level_filter_mismatch")
        end
        result.known_places_ok = true

        local observation, observation_error = gpt_world.record_observation({
            event_type = "place_observed",
            confirmed = true,
            entity_id = "poi:gpt_world_self_test:observation",
            level_id = test_level_id,
            source_id = "gpt_world_self_test_event",
            created_at = 2,
            confidence = 0.95
        })
        if observation == nil then
            error("observation_write:" .. tostring(observation_error))
        end
        if observation.status ~= "observed"
            or observation.predicate ~= "known_place"
            or observation.source_type ~= "observation" then
            error("observation_result_invalid")
        end
        result.observation_ok = true

        local rejected, reject_error = gpt_world.record_observation({
            event_type = "place_observed",
            confirmed = false,
            entity_id = "poi:gpt_world_self_test:unconfirmed",
            level_id = test_level_id,
            source_id = "gpt_world_self_test_event",
            created_at = 3
        })
        if rejected ~= nil or reject_error ~= "observation_not_confirmed" then
            error("unconfirmed_observation_was_not_rejected")
        end
        result.unconfirmed_observation_rejected_ok = true

        local context, context_error =
            gpt_world.get_companion_world_context(companion_alife_id)
        if type(context) ~= "table" or type(context.engine) ~= "table"
            or type(context.engine.level) ~= "table"
            or type(context.engine.level.entity_id) ~= "string" then
            error("world_context_unavailable:" .. tostring(context_error))
        end
        if type(context.knowledge) ~= "table"
            or context.knowledge.persistence ~= "session_only"
            or type(context.knowledge.known_places) ~= "table"
            or #context.knowledge.known_places ~= 2 then
            error("world_context_knowledge_mismatch")
        end
        result.context_level_entity_id = context.engine.level.entity_id
        result.test_level_entity_id = test_level_id
        result.context_is_online = context.engine.is_online == true
        result.context_ok = true
    end)

    -- Always restore caller data and IDs; self-test leaves no test claims.
    GPT_WORLD_CLAIMS = previous_claims
    GPT_WORLD_NEXT_CLAIM_ID = previous_next_claim_id

    if not run_ok then
        result.error = tostring(run_error)
        return result, "self_test_failed"
    end

    result.probe_passed = result.claim_write_ok
        and result.claim_read_ok
        and result.known_places_ok
        and result.observation_ok
        and result.unconfirmed_observation_rejected_ok
        and result.context_ok

    if not result.probe_passed then
        return result, "self_test_assertion_failed"
    end
    return result, nil
end
