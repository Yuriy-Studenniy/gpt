; GPT AI Companion - native X-Ray companion movement scheme.
; The standard companion scheme follows the player and yields control during combat.
; Generic stalker systems handle weapons, item pickup, corpse loot and wound treatment.

[logic]
active = companion@gpt_follow
take_items = true
can_select_weapon = true

[companion@gpt_follow]
; Keep the companion usable while suppressing the default weapon-down bark.
meet = gpt_companion_meet
wounded = gpt_companion_wounded
gather_items_enabled = true
corpse_detection_enabled = true

[gpt_companion_wounded]
use_medkit = true
autoheal = true
enable_talk = true


[gpt_companion_meet]
; CoP 1.6.02 xr_meet.script uses close_* fields for the active meet manager.
; The default armed-actor reaction is threat_na + meet_hide_weapon.
close_distance = 3
close_anim = {=actor_has_weapon} wait, talk_default
close_victim = {=actor_has_weapon} nil, actor
close_snd_distance = 3
close_snd_hello = {=actor_has_weapon} nil, meet_hello
close_snd_bye = nil
far_distance = 5
far_anim = nil
far_snd_distance = 5
far_snd = nil
far_victim = nil
snd_on_use = {=actor_has_weapon} nil, nil
use = true
meet_dialog = nil
abuse = false
trade_enable = true
allow_break = true
meet_on_talking = true
use_text = nil
