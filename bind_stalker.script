function init    (obj)
				xr_motivator.AddToMotivator(obj)
end

function actor_init    (npc)
				npc:bind_object(actor_binder(npc))
end

-- GPT AI Companion: needs are stored on the always-present actor so they
-- survive the companion switching between online and offline A-Life states.
-- Keep this shared API in the actor bootstrap: NPC motivator and corpse-loot
-- callbacks can run before the scripted A-Life squad class is first loaded.
local GPT_HUNGER_PER_GAME_MINUTE = 0.18
local GPT_THIRST_PER_GAME_MINUTE = 0.30

local function gpt_clamp_need(value)
	if value < 0 then
		return 0
	end
	if value > 100 then
		return 100
	end
	return value
end

-- Character-state interface. The current persistence backend is the actor's
-- save-backed PSTOR, but callers must not know or depend on that implementation.
local GPT_NEED_STORAGE_KEYS = {
	hunger = "gpt_need_hunger",
	thirst = "gpt_need_thirst"
}

function gpt_companion_get_need(need_name, default_value)
	local storage_key = GPT_NEED_STORAGE_KEYS[need_name]
	if storage_key == nil then
		return default_value
	end

	local actor = db.actor
	if actor == nil or db.storage[actor:id()] == nil then
		return default_value
	end

	return xr_logic.pstor_retrieve(actor, storage_key, default_value)
end

function gpt_companion_set_need(need_name, value)
	local storage_key = GPT_NEED_STORAGE_KEYS[need_name]
	if storage_key == nil or type(value) ~= "number" then
		return false
	end

	local actor = db.actor
	if actor == nil or db.storage[actor:id()] == nil then
		return false
	end

	xr_logic.pstor_store(actor, storage_key, gpt_clamp_need(value))
	return true
end

function gpt_companion_update_needs(squad, force_update)
	local actor = db.actor
	if actor == nil or db.storage[actor:id()] == nil then
		return
	end

	local hunger = gpt_companion_get_need("hunger", nil)
	local thirst = gpt_companion_get_need("thirst", nil)

	-- Migrate values from the first prototype, which stored them on the NPC.
	if (hunger == nil or thirst == nil) and squad ~= nil then
		for member in squad:squad_members() do
			local member_storage = db.storage[member.id]
			if member_storage ~= nil and member_storage.pstor ~= nil then
				if hunger == nil then
					hunger = member_storage.pstor.gpt_need_hunger
				end
				if thirst == nil then
					thirst = member_storage.pstor.gpt_need_thirst
				end
			end
		end
	end
	if hunger == nil then hunger = 0 end
	if thirst == nil then thirst = 0 end

	local current_time = game.get_game_time()
	local year, month, day, hour, minute, second, millisecond = 0, 0, 0, 0, 0, 0, 0
	year, month, day, hour, minute, second, millisecond =
		current_time:get(year, month, day, hour, minute, second, millisecond)

	local previous_year = xr_logic.pstor_retrieve(actor, "gpt_need_time_year", nil)
	if previous_year == nil then
		-- Establish a baseline for a new game or a save without need history.
		gpt_companion_set_need("hunger", hunger)
		gpt_companion_set_need("thirst", thirst)
		xr_logic.pstor_store(actor, "gpt_need_time_year", year)
		xr_logic.pstor_store(actor, "gpt_need_time_month", month)
		xr_logic.pstor_store(actor, "gpt_need_time_day", day)
		xr_logic.pstor_store(actor, "gpt_need_time_hour", hour)
		xr_logic.pstor_store(actor, "gpt_need_time_minute", minute)
		xr_logic.pstor_store(actor, "gpt_need_time_second", second)
		xr_logic.pstor_store(actor, "gpt_need_time_ms", millisecond)
		return
	end

	local previous_time = game.CTime()
	previous_time:set(
		previous_year,
		xr_logic.pstor_retrieve(actor, "gpt_need_time_month", 1),
		xr_logic.pstor_retrieve(actor, "gpt_need_time_day", 1),
		xr_logic.pstor_retrieve(actor, "gpt_need_time_hour", 0),
		xr_logic.pstor_retrieve(actor, "gpt_need_time_minute", 0),
		xr_logic.pstor_retrieve(actor, "gpt_need_time_second", 0),
		xr_logic.pstor_retrieve(actor, "gpt_need_time_ms", 0)
	)

	local elapsed_seconds = current_time:diffSec(previous_time)
	if elapsed_seconds < 0 then
		-- A clock reset should not decrease needs or create negative time.
		elapsed_seconds = 0
	elseif elapsed_seconds < 60 and force_update ~= true then
		-- Avoid writing the actor's save data on every simulation update.
		return
	end

	local elapsed_minutes = elapsed_seconds / 60
	hunger = gpt_clamp_need(hunger + GPT_HUNGER_PER_GAME_MINUTE * elapsed_minutes)
	thirst = gpt_clamp_need(thirst + GPT_THIRST_PER_GAME_MINUTE * elapsed_minutes)

	gpt_companion_set_need("hunger", hunger)
	gpt_companion_set_need("thirst", thirst)
	xr_logic.pstor_store(actor, "gpt_need_time_year", year)
	xr_logic.pstor_store(actor, "gpt_need_time_month", month)
	xr_logic.pstor_store(actor, "gpt_need_time_day", day)
	xr_logic.pstor_store(actor, "gpt_need_time_hour", hour)
	xr_logic.pstor_store(actor, "gpt_need_time_minute", minute)
	xr_logic.pstor_store(actor, "gpt_need_time_second", second)
	xr_logic.pstor_store(actor, "gpt_need_time_ms", millisecond)
end

function gpt_companion_get_needs()
	local actor = db.actor
	if actor == nil or db.storage[actor:id()] == nil then
		return nil
	end

	return {
		hunger = gpt_companion_get_need("hunger", 0),
		thirst = gpt_companion_get_need("thirst", 0)
	}
end

local game_difficulty_by_num = {
				[0] = "gd_novice",
				[1] = "gd_stalker",
				[2] = "gd_veteran",
				[3] = "gd_master"
				}

local weapon_hide = {}
local primary_objects_filled = false
-- Keep diagnostics in the game log; never send synthetic commands to the console.
local function gpt_companion_diagnostic(message)
	printf("[GPT_DIAG] %s", tostring(message))
end

-- GPT AI Companion: search several rings for a reachable vertex away from the actor.
local function gpt_companion_spawn_point(actor)
	local actor_vertex_id = actor:level_vertex_id()
	local angles = {45, -45, 90, -90, 135, -135, 180}
	local distances = {2.0, 3.0, 4.0, 6.0}

	for distance_index = 1, #distances do
		local distance = distances[distance_index]
		for angle_index = 1, #angles do
			local angle = angles[angle_index] * 0.017453292519943295769236907684886
			local forward = actor:direction()
			local cosine = math.cos(angle)
			local sine = math.sin(angle)
			local direction = vector():set(
				forward.x * cosine - forward.z * sine,
				forward.y,
				forward.x * sine + forward.z * cosine
			)
			local candidate = level.vertex_in_direction(actor_vertex_id, direction, distance)
			if candidate ~= nil and candidate ~= actor_vertex_id then
				return level.vertex_position(candidate), candidate
			end
		end
	end

	printf("[GPT_COMPANION] No safe nearby spawn vertex found")
	gpt_companion_diagnostic("No safe nearby spawn vertex found")
	return nil, nil
end

local function ensure_gpt_companion_squad(companion_id, actor)
	local story_id = "gpt_companion_squad"
	local existing_id = get_story_object_id(story_id)
	gpt_companion_diagnostic("Squad Story ID lookup " .. tostring(existing_id))
	local squad = nil

	if existing_id ~= nil then
		squad = alife():object(existing_id)
		if squad == nil then
			unregister_story_id(story_id)
		end
	end

	local companion = alife():object(companion_id)
	if companion == nil then
		printf("[GPT_COMPANION] ERROR: companion missing while registering squad")
		return nil, "companion_missing"
	end

	if companion:alive() ~= true then
		printf("[GPT_COMPANION] Companion is dead; preserving death and not recreating its squad")
		return nil, "companion_dead"
	end

	-- Detect ownership conflicts before creating a new group object. Otherwise
	-- a companion already assigned elsewhere would leave an empty orphan squad.
	if companion.group_id ~= 65535 and companion.group_id ~= nil
		and (squad == nil or companion.group_id ~= squad.id) then
		printf("[GPT_COMPANION] ERROR: companion %s already belongs to group %s",
			tostring(companion.id), tostring(companion.group_id))
		return nil, "companion_in_other_group"
	end

	if squad == nil then
		squad = alife():create(
			"gpt_companion_squad",
			companion.position,
			companion.m_level_vertex_id,
			companion.m_game_vertex_id
		)
	end

	if squad == nil then
		printf("[GPT_COMPANION] ERROR: squad creation returned nil")
		return nil, "squad_create_failed"
	end

	if companion.group_id == 65535 or companion.group_id == nil then
		local register_ok, register_error = pcall(function()
			squad:register_member(companion.id)
		end)
		if not register_ok then
			printf("[GPT_COMPANION] ERROR: squad registration failed: %s", tostring(register_error))
			return nil, "squad_registration_failed"
		end
		printf("[GPT_COMPANION] Registered companion %s in squad %s", tostring(companion.id), tostring(squad.id))
	elseif companion.group_id ~= squad.id then
		printf("[GPT_COMPANION] ERROR: companion %s already belongs to group %s", tostring(companion.id), tostring(companion.group_id))
		return nil, "companion_in_other_group"
	end

	if companion.group_id ~= squad.id then
		printf("[GPT_COMPANION] ERROR: companion was not attached to its A-Life squad")
		return nil, "squad_registration_not_confirmed"
	end

	local membership_ok, membership_found = pcall(function()
		for member in squad:squad_members() do
			if member.id == companion.id then
				return true
			end
		end
		return false
	end)
	if not membership_ok or not membership_found then
		printf("[GPT_COMPANION] ERROR: squad membership could not be confirmed")
		return nil, "squad_membership_not_confirmed"
	end

	local relation_ok, relation_error = pcall(function()
		squad:set_squad_relation()
	end)
	if not relation_ok then
		printf("[GPT_COMPANION] ERROR: squad relation setup failed: %s", tostring(relation_error))
		return nil, "squad_relation_failed"
	end

	-- Mirror sim_board:create_squad(): initialize the member's Team/Squad/Group
	-- fields after registration so the custom one-member squad follows the same
	-- bookkeeping path as vanilla-created squads.
	local member_setup_ok, member_setup_error = pcall(function()
		squad.board:setup_squad_and_group(companion)
	end)
	if not member_setup_ok then
		printf("[GPT_COMPANION] ERROR: squad member setup failed: %s", tostring(member_setup_error))
		return nil, "squad_member_setup_failed"
	end

	-- Sound registration is auxiliary: it must not invalidate a working A-Life squad.
	local sound_ok, sound_error = pcall(function()
		local sound_registered = false
		for _, entry in pairs(squad.sound_manager.npc) do
			if entry.npc_id == companion.id then
				sound_registered = true
				break
			end
		end
		if not sound_registered then
			squad.sound_manager:register_npc(companion.id)
		end
	end)
	if not sound_ok then
		printf("[GPT_COMPANION] WARNING: sound manager registration failed: %s", tostring(sound_error))
	end

	return squad.id, "ready"
end

-- Create the unique stalker once, then reuse the saved A-Life object.
local function ensure_gpt_companion_spawned(actor)
	local story_id = "gpt_companion_main"
	gpt_companion_diagnostic("Spawn routine entered")
	local existing_id = get_story_object_id(story_id)
	gpt_companion_diagnostic("Companion Story ID lookup " .. tostring(existing_id))

	if existing_id ~= nil then
		local existing_object = alife():object(existing_id)
		if existing_object ~= nil then
			printf("[GPT_COMPANION] Existing companion found: id=%s", tostring(existing_id))
			local squad_call_ok, squad_id, setup_status =
				pcall(ensure_gpt_companion_squad, existing_id, actor)
			if not squad_call_ok then
				printf("[GPT_COMPANION] ERROR: squad setup raised an exception: %s", tostring(squad_id))
				return nil, "squad_setup_exception", existing_id
			end
			if squad_id == nil then
				return nil, setup_status, existing_id
			end
			return existing_id, "ready", existing_id
		end
		unregister_story_id(story_id)
	end

	local spawn_position, spawn_vertex_id = gpt_companion_spawn_point(actor)
	if spawn_position == nil or spawn_vertex_id == nil then
		gpt_companion_diagnostic("Spawn aborted no_safe_spawn_point")
		return nil, "no_safe_spawn_point"
	end
	gpt_companion_diagnostic("Safe spawn vertex found " .. tostring(spawn_vertex_id))

	local companion = alife():create(
		"gpt_companion_main",
		spawn_position,
		spawn_vertex_id,
		actor:game_vertex_id()
	)

	if companion == nil then
		printf("[GPT_COMPANION] ERROR: companion creation returned nil")
		return nil, "companion_create_failed"
	end

	printf("[GPT_COMPANION] Created unique companion: id=%s", tostring(companion.id))
	gpt_companion_diagnostic("Created unique companion id " .. tostring(companion.id))
	local squad_call_ok, squad_id, setup_status =
		pcall(ensure_gpt_companion_squad, companion.id, actor)
	if not squad_call_ok then
		printf("[GPT_COMPANION] ERROR: squad setup raised an exception: %s", tostring(squad_id))
		return nil, "squad_setup_exception", companion.id
	end
	if squad_id == nil then
		return nil, setup_status, companion.id
	end

	return companion.id, "ready", companion.id
end

-- Probe the World Model independently from companion/squad setup.
-- Reading the global invokes X-Ray's namespace lazy loader for gpt_world.script.
local function gpt_world_log_module_status(binder)
	if binder.gpt_world_module_checked then
		return
	end
	binder.gpt_world_module_checked = true

	-- Console markers are visible in xray_administrator.log on retail CoP.
	-- printf output is not guaranteed to be written to that file.
	gpt_companion_diagnostic("world_module_probe_entered")

	local call_ok, levels = pcall(function()
		return gpt_world.get_catalog_levels()
	end)

	if not call_ok then
		gpt_companion_diagnostic("world_module_load_failed " .. string.sub(tostring(levels), 1, 120))
		printf("[GPT_WORLD] Module load failed: %s", tostring(levels))
		return
	end

	if type(levels) ~= "table" then
		gpt_companion_diagnostic("world_module_api_invalid_level_catalog")
		printf("[GPT_WORLD] Module API returned invalid level catalog")
		return
	end

	gpt_companion_diagnostic("world_module_loaded_levels_" .. tostring(#levels))
	printf("[GPT_WORLD] Module loaded; levels=%s", tostring(#levels))
end

-- Snapshot markers use the console channel visible in retail xray_administrator.log.
-- This diagnostic channel is separate from normal printf output.
local function gpt_world_snapshot_marker(name, value)
	local token = tostring(name)
	if value ~= nil then
		token = token .. "_" .. tostring(value)
	end
	token = string.sub(string.gsub(token, "[^%w_]", "_"), 1, 96)

	pcall(function()
		get_console():execute("gpt_companion_diag_world_snapshot_" .. token)
	end)
end

-- The snapshot is objective engine context, not persistent companion knowledge.
-- It is attempted as soon as the companion A-Life ID exists, even if squad setup
-- is still pending or failed.
local function gpt_companion_log_world_snapshot(companion_id)
	gpt_world_snapshot_marker("probe_entered")

	local call_ok, snapshot, error_code = pcall(function()
		return gpt_world.get_companion_location_snapshot(companion_id)
	end)

	if not call_ok then
		gpt_world_snapshot_marker("call_failed", string.sub(tostring(snapshot), 1, 72))
		return nil, "call_failed"
	end

	if snapshot == nil then
		gpt_world_snapshot_marker("unavailable", error_code or "unknown")
		return nil, error_code or "unknown"
	end

	local level_name = snapshot.level and snapshot.level.name
	if type(level_name) == "string" and level_name ~= "" then
		gpt_world_snapshot_marker("level", level_name)
	else
		gpt_world_snapshot_marker("level_unavailable")
	end

	gpt_world_snapshot_marker("online", tostring(snapshot.is_online))

	local smart_name = snapshot.smart_terrain and snapshot.smart_terrain.name
	if type(smart_name) == "string" and smart_name ~= "" then
		gpt_world_snapshot_marker("smart", smart_name)
	else
		gpt_world_snapshot_marker("smart_none")
	end

	-- Mark the core location snapshot complete before inspecting optional
	-- Smart Terrain metadata. The companion may legitimately have no Smart Terrain.
	gpt_world_snapshot_marker("read_ok")

	-- Optional metadata must never prevent the knowledge API probe from running.
	local smart_meta_ok, smart_meta_error = pcall(function()
		if type(snapshot.smart_terrain_status) == "string" then
			gpt_world_snapshot_marker("smart_status", snapshot.smart_terrain_status)
		end
		if type(snapshot.smart_terrain_alife_object_id) == "number" then
			gpt_world_snapshot_marker("smart_id", tostring(snapshot.smart_terrain_alife_object_id))
		end
	end)
	if not smart_meta_ok then
		gpt_world_snapshot_marker("smart_metadata_failed", string.sub(tostring(smart_meta_error), 1, 48))
	end

	return snapshot, nil
end

-- Retry briefly until the companion is confirmed online. Smart Terrain is
-- optional for this player-following companion and must not block snapshot completion.
-- Exercise the public knowledge/context API once after the companion is online.
-- The World Model helper isolates and restores its temporary claims.
local function gpt_companion_log_knowledge_api(companion_id)
	gpt_world_snapshot_marker("knowledge_api_probe_entered")
	local call_ok, results, error_code = pcall(function()
		return gpt_world.run_knowledge_api_self_test(companion_id)
	end)

	gpt_world_snapshot_marker("knowledge_api_probe_returned")
	if not call_ok then
		gpt_world_snapshot_marker("knowledge_api_call_failed", string.sub(tostring(results), 1, 64))
		return
	end
	if type(results) ~= "table" then
		gpt_world_snapshot_marker("knowledge_api_call_failed", error_code or "no_result")
		return
	end

	local checks = {
		"claim_write_ok",
		"claim_read_ok",
		"known_places_ok",
		"observation_ok",
		"unconfirmed_observation_rejected_ok",
		"context_ok"
	}
	for _, check_name in ipairs(checks) do
		if results[check_name] == true then
			gpt_world_snapshot_marker("knowledge_api_" .. check_name)
		else
			gpt_world_snapshot_marker("knowledge_api_" .. check_name .. "_failed")
		end
	end

	if results.probe_passed == true then
		gpt_world_snapshot_marker("knowledge_api_probe_passed")
	else
		gpt_world_snapshot_marker("knowledge_api_probe_failed", error_code or results.error or "assertion")
	end
end

local function gpt_update_world_snapshot(binder, now)
	local companion_id = binder.gpt_world_snapshot_companion_id
	if companion_id == nil or binder.gpt_world_snapshot_done then
		return
	end
	if binder.gpt_world_snapshot_retry_at ~= nil and now < binder.gpt_world_snapshot_retry_at then
		return
	end

	binder.gpt_world_snapshot_attempts = (binder.gpt_world_snapshot_attempts or 0) + 1
	local attempt = binder.gpt_world_snapshot_attempts
	gpt_world_snapshot_marker("attempt", tostring(attempt))

	local snapshot = gpt_companion_log_world_snapshot(companion_id)
	if snapshot ~= nil and snapshot.is_online == true then
		if not binder.gpt_world_knowledge_api_checked then
			binder.gpt_world_knowledge_api_checked = true
			gpt_companion_log_knowledge_api(companion_id)
		end
		binder.gpt_world_snapshot_done = true
		gpt_world_snapshot_marker("polling_complete")
		return
	end

	if attempt >= 5 then
		binder.gpt_world_snapshot_done = true
		gpt_world_snapshot_marker("polling_finished", tostring(attempt))
		return
	end

	binder.gpt_world_snapshot_retry_at = now + 2000
end

local function gpt_update_companion_setup(binder)
	if not binder.gpt_companion_diagnostic_logged then
		binder.gpt_companion_diagnostic_logged = true
		gpt_companion_diagnostic("actor_binder setup updater entered")
	end

	local now = time_global()
	gpt_update_world_snapshot(binder, now)

	if binder.gpt_companion_setup_complete or binder.gpt_companion_setup_blocked then
		return
	end
	if binder.gpt_companion_setup_retry_at ~= nil and now < binder.gpt_companion_setup_retry_at then
		return
	end

	binder.gpt_companion_setup_attempts = (binder.gpt_companion_setup_attempts or 0) + 1
	local call_ok, companion_id, setup_status, candidate_companion_id =
		pcall(ensure_gpt_companion_spawned, binder.object)
	if not call_ok then
		setup_status = "setup_exception: " .. tostring(companion_id)
		gpt_companion_diagnostic("Setup exception " .. tostring(companion_id))
		companion_id = nil
		candidate_companion_id = nil
	end

	-- The A-Life ID is available even if squad registration needs a retry.
	-- Keep factual location telemetry independent from A-Life squad success.
	local snapshot_companion_id = companion_id or candidate_companion_id
	if snapshot_companion_id ~= nil and binder.gpt_world_snapshot_companion_id == nil then
		binder.gpt_world_snapshot_companion_id = snapshot_companion_id
		binder.gpt_world_snapshot_attempts = 0
		binder.gpt_world_snapshot_retry_at = now + 1000
		binder.gpt_world_snapshot_done = false
	end
	gpt_update_world_snapshot(binder, now)

	if companion_id ~= nil then
		binder.gpt_companion_setup_complete = true
		binder.gpt_companion_setup_retry_at = nil
		printf("[GPT_COMPANION] Setup complete: companion=%s", tostring(companion_id))
		gpt_companion_diagnostic("Setup complete companion " .. tostring(companion_id))
		return
	end

	-- A dead companion or one already owned by another squad is a persistent
	-- state conflict, not a transient spawn failure. Preserve it without retrying.
	if setup_status == "companion_dead" or setup_status == "companion_in_other_group" then
		binder.gpt_companion_setup_blocked = true
		printf("[GPT_COMPANION] Setup halted: %s", tostring(setup_status))
		gpt_companion_diagnostic("Setup halted " .. tostring(setup_status))
		return
	end

	-- Exponential backoff avoids retrying every frame while allowing recovery
	-- from transient A-Life registration/spawn failures.
	local exponent = math.min(binder.gpt_companion_setup_attempts - 1, 5)
	local retry_delay = math.min(1000 * (2 ^ exponent), 30000)
	if binder.gpt_companion_setup_attempts > 6 then
		retry_delay = 60000
	end
	binder.gpt_companion_setup_retry_at = now + retry_delay
	gpt_companion_diagnostic("Setup attempt " .. tostring(binder.gpt_companion_setup_attempts)
		.. " failed " .. tostring(setup_status) .. " retry in " .. tostring(retry_delay) .. " ms")
	printf("[GPT_COMPANION] Setup attempt %s failed (%s); retry in %s ms",
		tostring(binder.gpt_companion_setup_attempts), tostring(setup_status), tostring(retry_delay))
end

----------------------------------------------------------------------------------------------------------------------
class "actor_binder" (object_binder)
----------------------------------------------------------------------------------------------------------------------
function actor_binder:__init (obj) super(obj)
	self.bCheckStart = false
	self.weather_manager = level_weathers.get_weather_manager()
	self.surge_manager = surge_manager.get_surge_manager()
	--self.actor_detector = xr_detector.actor_detector()
	self.last_level_name = nil
	self.deimos_intensity = nil
--	self.actor_weapon_on_start = true
	self.loaded_active_slot = 3
	self.loaded_slot_applied = false
	self.last_detective_achievement_spawn_time = nil
	self.last_mutant_hunter_achievement_spawn_time = nil
	self.gpt_companion_setup_complete = false
	self.gpt_companion_setup_blocked = false
	self.gpt_companion_setup_attempts = 0
	self.gpt_companion_setup_retry_at = nil
	self.gpt_world_snapshot_companion_id = nil
	self.gpt_world_snapshot_attempts = 0
	self.gpt_world_snapshot_retry_at = nil
	self.gpt_world_snapshot_done = false
	self.gpt_world_knowledge_api_checked = false
end
----------------------------------------------------------------------------------------------------------------------
function actor_binder:net_spawn(data)
--	printf("actor net spawn")
	level.show_indicators()
	self.bCheckStart = true
	self.weapon_hide = false -- ñïðÿòàíî èëè íåò îðóæèå ïðè ðàçãîâîðå.
	self.weapon_hide_in_dialog = false
	weapon_hide = {} -- óñòàíàâëèâàåì ãëîáàëüíûé äåôîëòîâûé ôëàã.
	if object_binder.net_spawn(self,data) == false then
		return false
	end
	db.add_actor(self.object)
	db.actor.deimos_intensity = self.deimos_intensity
	self.deimos_intensity = nil
	if self.st.disable_input_time == nil then
		level.enable_input()
	end
	xr_s.on_game_load()                                    --' Distemper 03.2008 --
	self.weather_manager:reset()
	--' Çàãðóæàåì íàñòðîéêè äðîïà
	death_manager.init_drop_settings()
	--'Óñòàíàâëèâàåì ññûëêó íà òàñêìåíåäæåð
	self.task_manager = task_manager.get_task_manager()
	self.spawn_frame = device().frame
	self.already_jumped = false
	self.loaded = false
	self.gpt_companion_setup_complete = false
	self.gpt_companion_setup_blocked = false
	self.gpt_companion_setup_attempts = 0
	self.gpt_companion_setup_retry_at = nil
	self.gpt_world_snapshot_companion_id = nil
	self.gpt_world_snapshot_attempts = 0
	self.gpt_world_snapshot_retry_at = nil
	self.gpt_world_snapshot_done = false
	self.gpt_world_knowledge_api_checked = false
	benchmark.main()							          --' Distemper 06.2008 --
	return true
end
----------------------------------------------------------------------------------------------------------------------
function actor_binder:net_destroy()
	xr_sound.stop_sounds_by_id(self.object:id())
	local board_factions = sim_board.get_sim_board().players
	if(board_factions) then
			for k,v in pairs (board_factions) do
					xr_sound.stop_sounds_by_id(v.id)
			end
	end
	if(actor_stats.remove_from_ranking~=nil)then
		actor_stats.remove_from_ranking(self.object:id())
	end
	level.show_weapon(true)
	db.del_actor(self.object)

	self.object:set_callback(callback.inventory_info, nil)
	self.object:set_callback(callback.article_info, nil)
	self.object:set_callback(callback.on_item_take, nil)
	self.object:set_callback(callback.on_item_drop, nil)
	self.object:set_callback(callback.task_state, nil)
	self.object:set_callback(callback.level_border_enter, nil)
	self.object:set_callback(callback.level_border_exit, nil)
	self.object:set_callback(callback.take_item_from_box, nil)
	self.object:set_callback(callback.use_object, nil)

	log("--------->"..tostring(_G.amb_vol))
	log("--------->"..tostring(_G.mus_vol))
	if(_G.amb_vol~=0) then
		get_console():execute("snd_volume_eff "..tostring(_G.amb_vol))
		_G.amb_vol = 0
	end
	if(_G.mus_vol~=0) then
	    get_console():execute("snd_volume_music "..tostring(_G.mus_vol))
		_G.mus_vol = 0
	end
	if sr_psy_antenna.psy_antenna then
		sr_psy_antenna.psy_antenna:destroy()
		sr_psy_antenna.psy_antenna = false
	end
	xrs_dyn_music.finish_theme()
	xr_s.on_actor_destroy()
	object_binder.net_destroy(self)
end
----------------------------------------------------------------------------------------------------------------------
function actor_binder:reinit()
	object_binder.reinit(self)
	local npc_id = self.object:id()
	db.storage[npc_id] = { }
	self.st = db.storage[npc_id]
	self.st.pstor = nil

	self.object:set_callback(callback.inventory_info, self.info_callback, self)
	self.object:set_callback(callback.on_item_take, self.on_item_take, self)
	self.object:set_callback(callback.on_item_drop, self.on_item_drop, self)
	self.object:set_callback(callback.trade_sell_buy_item, self.on_trade, self) -- for game stats
	self.object:set_callback(callback.task_state, self.task_callback, self)
	self.object:set_callback(callback.take_item_from_box, self.take_item_from_box, self)
	self.object:set_callback(callback.use_object, self.use_inventory_item, self)
end
