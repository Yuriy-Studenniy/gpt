local corpse_contain_any_valuable
local gpt_loot_target = nil
local gpt_loot_counts = nil
local gpt_loot_needs = nil

local gpt_loot_ammo_taken = nil
local gpt_loot_ammo_needed = false

local gpt_loot_equipment_best = nil
local gpt_loot_equipment_taken = nil
local gpt_loot_equipment_candidates = nil
local gpt_loot_detector_rank = 0

local gpt_detector_ranks = {
	["detector_simple"] = 1,
	["detector_advanced"] = 2,
	["detector_elite"] = 3,
	["detector_scientific"] = 4
}

local function gpt_get_item_value(item)
	local ok_cost, cost = pcall(function()
		return item:cost()
	end)
	local ok_condition, condition = pcall(function()
		return item:condition()
	end)

	if not ok_cost or not ok_condition
		or type(cost) ~= "number" or type(condition) ~= "number" then
		return nil
	end

	if cost < 0 then cost = 0 end
	if condition < 0 then condition = 0 end
	if condition > 1 then condition = 1 end
	return cost * condition
end

local function gpt_read_protection(section, field)
	local ini = system_ini()
	if not ini:line_exist(section, field) then
		return 0
	end

	local ok, value = pcall(function()
		return ini:r_float(section, field)
	end)
	if ok and type(value) == "number" then
		return value
	end
	return 0
end

local function gpt_get_equipment_profile(item)
	if item == nil then
		return nil, nil
	end

	local section = item:section()
	local item_value = gpt_get_item_value(item)
	if item_value == nil then
		return nil, nil
	end

	if isWeapon(item) then
		-- Read weapon class metadata from the config. Some CoP sections do not
		-- define ef_main_weapon_type; calling the C++ getter on those can assert.
		local ini = system_ini()
		local weapon_type = 255
		if ini:line_exist(section, "ef_main_weapon_type") then
			local ok, value = pcall(function()
				return ini:r_u32(section, "ef_main_weapon_type")
			end)
			if ok and type(value) == "number" then
				weapon_type = value
			end
		end
		if weapon_type == 255 and ini:line_exist(section, "ef_weapon_type") then
			local ok, value = pcall(function()
				return ini:r_u32(section, "ef_weapon_type")
			end)
			if ok and type(value) == "number" then
				weapon_type = value
			end
		end
		return "weapon_" .. tostring(weapon_type), item_value
	end

	if string.find(section, "_outfit") ~= nil then
		-- Compare suits by configured protection, adjusted for actual condition.
		local protection =
			2 * gpt_read_protection(section, "strike_protection")
			+ 2 * gpt_read_protection(section, "explosion_protection")
			+ 2 * gpt_read_protection(section, "wound_protection")
			+ gpt_read_protection(section, "burn_protection")
			+ gpt_read_protection(section, "shock_protection")
			+ 1.5 * gpt_read_protection(section, "chemical_burn_protection")
			+ 20 * gpt_read_protection(section, "radiation_protection")
			+ 2 * gpt_read_protection(section, "telepatic_protection")

		local cost = math.max(item:cost(), 1)
		local condition = item_value / cost
		if protection <= 0 then
			protection = item_value / 1000
			condition = 1
		end
		return "outfit", protection * condition
	end

	if string.sub(section, 1, 5) == "helm_" then
		return "helmet", item_value
	end

	return nil, nil
end

local function gpt_detector_rank(section)
	return gpt_detector_ranks[section] or 0
end


local function gpt_check_weapon_ammo(wanted_section, item)
	if not isWeapon(item) then
		return
	end

	local weapon_section = item:section()
	local ini = system_ini()
	if not ini:line_exist(weapon_section, "ammo_class") then
		return
	end

	local ammo_text = ini:r_string(weapon_section, "ammo_class")
	local ammo_sections = utils.parse_names(ammo_text)
	for i = 1, #ammo_sections do
		if ammo_sections[i] == wanted_section then
			local total_ammo = item:get_ammo_total()
			local magazine_ammo = item:get_ammo_in_magazine()
			local reserve_ammo = total_ammo - magazine_ammo

			local reserve_target = 60
			if ini:line_exist(weapon_section, "ammo_mag_size") then
				local magazine_size = ini:r_u32(weapon_section, "ammo_mag_size")
				reserve_target = magazine_size * 2
				if reserve_target < 4 then
					reserve_target = 4
				elseif reserve_target > 120 then
					reserve_target = 120
				end
			end

			if reserve_ammo < reserve_target then
				gpt_loot_ammo_needed = true
			end
			return
		end
	end
end

local function gpt_wants_ammo(section)
	if gpt_loot_ammo_taken == nil or gpt_loot_ammo_taken[section] == true then
		return false
	end

	gpt_loot_ammo_needed = false
	gpt_loot_target:iterate_inventory(gpt_check_weapon_ammo, section)
	return gpt_loot_ammo_needed
end

local gpt_food_sections = {
	["bread"] = true,
	["kolbasa"] = true,
	["conserva"] = true
}
local gpt_medkit_sections = {
	["medkit"] = true,
	["medkit_army"] = true,
	["medkit_scientic"] = true
}

local function gpt_count_loot_inventory(npc, item)
	if gpt_loot_counts == nil then
		return
	end

	local section = item:section()
	if gpt_food_sections[section] then
		gpt_loot_counts.food = gpt_loot_counts.food + 1
	elseif section == "energy_drink" then
		gpt_loot_counts.drinks = gpt_loot_counts.drinks + 1
	elseif gpt_medkit_sections[section] then
		gpt_loot_counts.medkits = gpt_loot_counts.medkits + 1
	elseif section == "bandage" then
		gpt_loot_counts.bandages = gpt_loot_counts.bandages + 1
	elseif section == "grenade_f1" or section == "grenade_rgd5" then
		gpt_loot_counts.grenades = gpt_loot_counts.grenades + 1
	end

	local equipment_group, equipment_score = gpt_get_equipment_profile(item)
	if equipment_group ~= nil and equipment_score ~= nil then
		local current_best = gpt_loot_equipment_best[equipment_group]
		if current_best == nil or equipment_score > current_best then
			gpt_loot_equipment_best[equipment_group] = equipment_score
		end
	end

	local detector_rank = gpt_detector_rank(section)
	if detector_rank > gpt_loot_detector_rank then
		gpt_loot_detector_rank = detector_rank
	end
end

local function gpt_begin_loot_context(npc)
	-- Preserve vanilla looting for every NPC except our unique companion.
	if npc == nil or get_story_objects_registry():get_story_id(npc:id()) ~= "gpt_companion_main" then
		gpt_loot_target = nil
		gpt_loot_counts = nil
		gpt_loot_needs = nil
		gpt_loot_ammo_taken = nil
		gpt_loot_equipment_best = nil
		gpt_loot_equipment_taken = nil
		gpt_loot_equipment_candidates = nil
		gpt_loot_detector_rank = 0
		return
	end

	gpt_loot_target = npc
	gpt_loot_counts = {food = 0, drinks = 0, medkits = 0, bandages = 0, grenades = 0}
	gpt_loot_ammo_taken = {}
	gpt_loot_equipment_best = {}
	gpt_loot_equipment_taken = {}
	gpt_loot_equipment_candidates = nil
	gpt_loot_detector_rank = 0
	npc:iterate_inventory(gpt_count_loot_inventory, npc)

	local needs = gpt_companion_get_needs()
	local hunger = needs and needs.hunger or 0
	local thirst = needs and needs.thirst or 0

	gpt_loot_needs = {
		hunger = hunger,
		thirst = thirst,
		health = npc.health
	}
end

local function gpt_end_loot_context()
	gpt_loot_target = nil
	gpt_loot_counts = nil
	gpt_loot_needs = nil
	gpt_loot_ammo_taken = nil
	gpt_loot_equipment_best = nil
	gpt_loot_equipment_taken = nil
	gpt_loot_equipment_candidates = nil
	gpt_loot_detector_rank = 0
end

local function gpt_wants_loot_section(section, item)
	if gpt_loot_target == nil or gpt_loot_counts == nil then
		return true
	end

	if gpt_food_sections[section] then
		local max_food = 2
		if gpt_loot_needs.hunger >= 75 then
			max_food = 3
		end
		return gpt_loot_counts.food < max_food
	end

	if section == "vodka" then
		-- Alcohol is not treated as hydration; there is no coping/alcohol motive yet.
		return false
	end

	if string.sub(section, 1, 5) == "drug_" then
		return gpt_loot_target:object(section) == nil
	end

	if section == "energy_drink" then
		local max_drinks = 1
		if gpt_loot_needs.thirst >= 75 then
			max_drinks = 2
		end
		return gpt_loot_counts.drinks < max_drinks
	end

	if gpt_medkit_sections[section] then
		local max_medkits = 2
		if gpt_loot_needs.health <= 0.55 then
			max_medkits = 3
		end
		return gpt_loot_counts.medkits < max_medkits
	end

	if section == "bandage" then
		return gpt_loot_counts.bandages < 2
	end

	if section == "grenade_f1" or section == "grenade_rgd5" then
		return gpt_loot_counts.grenades < 4
	end

	if string.sub(section, 1, 5) == "ammo_" then
		return gpt_wants_ammo(section)
	end

	-- Upgrade only equipment that is better than what the companion carries.
	-- Only one item per equipment group is accepted from each corpse.
	local equipment_group, equipment_score = gpt_get_equipment_profile(item)
	if equipment_group ~= nil and equipment_score ~= nil then
		if gpt_loot_equipment_taken[equipment_group] == true then
			return false
		end

		local current_best = gpt_loot_equipment_best[equipment_group]
		if current_best == nil then
			return equipment_score > 0
		end
		return equipment_score > current_best * 1.10
	end

	local detector_rank = gpt_detector_rank(section)
	if detector_rank > 0 then
		return gpt_loot_equipment_taken.detector ~= true
			and detector_rank > gpt_loot_detector_rank
	end

	-- Attachments and other special weapon objects are kept once per section.
	if string.sub(section, 1, 4) == "wpn_"
		or string.sub(section, 1, 5) == "helm_"
		or string.find(section, "_outfit") ~= nil then
		return gpt_loot_target:object(section) == nil
	end

	return true
end

local function gpt_mark_loot_taken(section, item)
	if gpt_loot_counts == nil then
		return
	end

	if string.sub(section, 1, 5) == "ammo_" and gpt_loot_ammo_taken ~= nil then
		gpt_loot_ammo_taken[section] = true
	end

	if equipment_group ~= nil then
		gpt_loot_equipment_taken[equipment_group] = true
	end
	if gpt_detector_rank(section) > 0 then
		gpt_loot_equipment_taken.detector = true
		gpt_loot_detector_rank = gpt_detector_rank(section)
	end

	if gpt_food_sections[section] then
		gpt_loot_counts.food = gpt_loot_counts.food + 1
	elseif section == "energy_drink" then
		gpt_loot_counts.drinks = gpt_loot_counts.drinks + 1
	elseif gpt_medkit_sections[section] then
		gpt_loot_counts.medkits = gpt_loot_counts.medkits + 1
	elseif section == "bandage" then
		gpt_loot_counts.bandages = gpt_loot_counts.bandages + 1
	elseif section == "grenade_f1" or section == "grenade_rgd5" then
		gpt_loot_counts.grenades = gpt_loot_counts.grenades + 1
	end
end


function check_item(npc, item)
	local section = item:section()
	if lootable_table[section] == true and gpt_wants_loot_section(section, item) then
		corpse_contain_any_valuable = true
	end
end

local function gpt_release_selected_corpse(npc, storage)
	if storage == nil then
		return
	end

	local selected_id = storage.selected_corpse_id
	if selected_id ~= nil then
		local corpse_storage = db.storage[selected_id]
		if corpse_storage ~= nil and corpse_storage.corpse_already_selected == npc:id() then
			corpse_storage.corpse_already_selected = nil
		end
	end

	storage.selected_corpse_id = nil
	storage.vertex_id = nil
	storage.vertex_position = nil
end

----------------------------------------------------------------------------------------------------------------------
-- EVALUATORS
----------------------------------------------------------------------------------------------------------------------
class "evaluator_corpse" (property_evaluator)
function evaluator_corpse:__init(name, storage, npc) super (nil, name)
	self.a = storage
end
function evaluator_corpse:evaluate()
	if not self.object:alive() then
		gpt_release_selected_corpse(self.object, self.a)
		return false
	end

	if self.object:best_enemy() ~= nil then
		gpt_release_selected_corpse(self.object, self.a)
		return false
	end

	if self.object:character_community() == "zombied" then
		gpt_release_selected_corpse(self.object, self.a)
		return false
	end

	if self.a.corpse_detection_enabled == false then
		gpt_release_selected_corpse(self.object, self.a)
		return false
	end

	if xr_wounded.is_wounded(self.object) then
		gpt_release_selected_corpse(self.object, self.a)
		return false
	end

	if self.object:section() == "actor_visual_stalker" then
		gpt_release_selected_corpse(self.object, self.a)
		return false
	end

	local corpses = release_body_manager.get_release_body_manager().release_objects_table

	local nearest_corpse_dist = 400 -- Áóäåò âûáèðàòü òîëüêî òðóïû, áëèæå ÷åì ýòà äèñòàíöèÿ (ïðîâåðÿåòñÿ ïî êâàäðàòó ðàññòîÿíèÿ)
	local nearest_corpse_vertex = nil
	local nearest_corpse_position = nil
	local corpse_id	= nil

	local scan_ok, scan_error = pcall(function()
		gpt_begin_loot_context(self.object)
		for k,v in pairs(corpses) do
			local id = v.id
			local corpse_npc = db.storage[id] and db.storage[id].object
	
			if corpse_npc ~= nil and self.object:see(corpse_npc) and (db.storage[id].corpse_already_selected == nil or db.storage[id].corpse_already_selected == self.object:id()) then
				if self.object:position():distance_to_sqr(corpse_npc:position()) < nearest_corpse_dist then
	
					corpse_contain_any_valuable = nil
					corpse_npc:iterate_inventory(check_item, corpse_npc)
	
					if corpse_contain_any_valuable == true then
	
						--printf("FOUND NEW PRIOR CORPSE %s", corpse_npc:name())
						local corpse_vertex = level.vertex_id(corpse_npc:position())
						if self.object:accessible(corpse_vertex) then
							nearest_corpse_dist = self.object:position():distance_to_sqr(corpse_npc:position())
							nearest_corpse_vertex = corpse_vertex
							nearest_corpse_position = corpse_npc:position()
							corpse_id = id
						end
	
					end
	--			else
	--				printf("FOUND CORPSE %s FAR %s", corpse_npc:name(), self.object:position():distance_to_sqr(corpse_npc:position()))
				end
	
			end
		end
	
	
	end)

	-- Global loot state must never leak into another NPC's corpse evaluation.
	gpt_end_loot_context()
	if not scan_ok then
		gpt_release_selected_corpse(self.object, self.a)
		printf("[GPT_COMPANION] Corpse scan failed: %s", tostring(scan_error))
		return false
	end
	if nearest_corpse_vertex ~= nil then
		if self.a.selected_corpse_id ~= nil and self.a.selected_corpse_id ~= corpse_id then
			gpt_release_selected_corpse(self.object, self.a)
		end

		self.a.selected_corpse_id = corpse_id
		self.a.vertex_id = nearest_corpse_vertex
		self.a.vertex_position = nearest_corpse_position
		db.storage[self.a.selected_corpse_id].corpse_already_selected = self.object:id()		
		
		return true
	end

	gpt_release_selected_corpse(self.object, self.a)
	return false
end



----------------------------------------------------------------------------------------------------------------------
--Actions
----------------------------------------------------------------------------------------------------------------------
class "action_search_corpse" (action_base)
function action_search_corpse:__init (npc_name,action_name, storage) super (nil, action_name)
	self.a = storage
end
function action_search_corpse:initialize()
	action_base.initialize(self)
	self.object:set_desired_position()
	self.object:set_desired_direction()

	self.object:set_dest_level_vertex_id(self.a.vertex_id)
	--state_mgr.set_state(self.object, "patrol", nil, nil, {look_position = self.a.vertex_position})
	state_mgr.set_state(self.object, "patrol")
end
function action_search_corpse:execute ()
	action_base.execute(self)

	if self.object:position():distance_to_sqr(self.a.vertex_position) > 2 then
		return
	end

	state_mgr.set_state(self.object, "search_corpse", nil, nil, {look_position = self.a.vertex_position})
	xr_sound.set_sound_play(self.object:id(), "corpse_loot_begin")
end
function action_search_corpse:finalize ()
	gpt_release_selected_corpse(self.object, self.a)
	action_base.finalize(self)
end

local transfer_to_npc = nil

local function gpt_select_best_equipment(npc, item)
	local section = item:section()
	if lootable_table[section] ~= true then
		return
	end

	local equipment_group, equipment_score = gpt_get_equipment_profile(item)
	if equipment_group ~= nil and equipment_score ~= nil
		and gpt_wants_loot_section(section, item) then
		local selected = gpt_loot_equipment_candidates[equipment_group]
		if selected == nil or equipment_score > selected.score then
			gpt_loot_equipment_candidates[equipment_group] = {
				id = item:id(),
				score = equipment_score
			}
		end
		return
	end

	local detector_rank = gpt_detector_rank(section)
	if detector_rank > 0 and gpt_wants_loot_section(section, item) then
		local selected = gpt_loot_equipment_candidates.detector
		if selected == nil or detector_rank > selected.score then
			gpt_loot_equipment_candidates.detector = {
				id = item:id(),
				score = detector_rank
			}
		end
	end
end

function get_item(npc, item)
	local section = item:section()
	if lootable_table[section] ~= true then
		return
	end

	local equipment_group = gpt_get_equipment_profile(item)
	if gpt_loot_equipment_candidates ~= nil then
		if equipment_group ~= nil then
			local selected = gpt_loot_equipment_candidates[equipment_group]
			if selected == nil or selected.id ~= item:id() then
				return
			end
		elseif gpt_detector_rank(section) > 0 then
			local selected = gpt_loot_equipment_candidates.detector
			if selected == nil or selected.id ~= item:id() then
				return
			end
		end
	end

	if gpt_wants_loot_section(section, item) then
		if gpt_loot_target == nil then
			-- Keep the vanilla one-pass transfer path for every other NPC.
			npc:transfer_item(item, transfer_to_npc)
			return
		end

		local target_id = transfer_to_npc:id()
		npc:transfer_item(item, transfer_to_npc)

		-- transfer_item() has no documented return value in the target API.
		-- Confirm ownership through the item's parent before updating loot limits.
		local parent_ok, parent = pcall(function()
			return item:parent()
		end)
		local transfer_confirmed = false
		if parent_ok and parent ~= nil then
			local id_ok, parent_id = pcall(function()
				return parent:id()
			end)
			transfer_confirmed = id_ok and parent_id == target_id
		end

		if transfer_confirmed then
			gpt_mark_loot_taken(section, equipment_group)
		else
			printf("[GPT_COMPANION] Item transfer was not confirmed for %s", section)
		end
	end
end

function get_all_from_corpse(npc)
	printf("GET ALL FROM CORPSE")

	local npc_storage = db.storage[npc:id()]
	local corpse_detection = npc_storage and npc_storage.corpse_detection
	local corpse_npc_id = corpse_detection and corpse_detection.selected_corpse_id
	local corpse_storage = corpse_npc_id and db.storage[corpse_npc_id]
	local corpse_npc = corpse_storage and corpse_storage.object

	if corpse_npc == nil then
		gpt_release_selected_corpse(npc, corpse_detection)
		return
	end

	transfer_to_npc = npc
	local loot_ok, loot_error = pcall(function()
		gpt_begin_loot_context(npc)
		-- The quality-based two-pass selection is exclusive to our companion.
		-- Other NPCs retain the original one-pass vanilla loot transfer.
		if gpt_loot_target ~= nil then
			gpt_loot_equipment_candidates = {}
			corpse_npc:iterate_inventory(gpt_select_best_equipment, corpse_npc)
		end
		corpse_npc:iterate_inventory(get_item, corpse_npc)
	end)

	-- Always release temporary state, even if an inventory operation fails.
	gpt_end_loot_context()
	transfer_to_npc = nil

	if not loot_ok then
		gpt_release_selected_corpse(npc, corpse_detection)
		printf("[GPT_COMPANION] Corpse loot failed: %s", tostring(loot_error))
		return
	end

	if math.random(100) > 20 then
		xr_sound.set_sound_play(npc:id(), "corpse_loot_begin")
	else
		xr_sound.set_sound_play(npc:id(), "corpse_loot_bad")
	end
end

----------------------------------------------------------------------------------------------------------------------
-- BINDER
----------------------------------------------------------------------------------------------------------------------
function add_to_binder(npc, char_ini, scheme, section, st)
	local operators	= {}
	local properties  = {}


	properties["corpse_exist"]				= xr_evaluators_id.corpse_exist
	properties["wounded"]					= xr_evaluators_id.sidor_wounded_base

	operators["search_corpse"]				= xr_actions_id.corpse_exist
	operators["state_mgr_to_idle_alife"]	= xr_actions_id.state_mgr + 2

	local manager = npc:motivation_action_manager()


	-- Evaluators
	manager:add_evaluator (properties["corpse_exist"], 		evaluator_corpse("corpse_exist", st))

	-- Actions
	local action = action_search_corpse (npc:name(),"action_search_corpse", st)
	action:add_precondition		(world_property(stalker_ids.property_alive, true))
	action:add_precondition		(world_property(stalker_ids.property_enemy,	false))
	action:add_precondition		(world_property(stalker_ids.property_danger,false))
	action:add_precondition		(world_property(stalker_ids.property_anomaly,false))
	action:add_precondition		(world_property(stalker_ids.property_items,false))
	action:add_precondition		(world_property(properties["corpse_exist"],	true))
	action:add_precondition		(world_property(properties["wounded"], 		false))
	action:add_precondition 	(world_property(xr_evaluators_id.wounded_exist,		false))
	action:add_effect (world_property(properties["corpse_exist"], 			false))
	manager:add_action (operators["search_corpse"], action)

	action = manager:action (xr_actions_id.alife)
	action:add_precondition		(world_property(properties["corpse_exist"],		false))

	action = manager:action (operators["state_mgr_to_idle_alife"])
	action:add_precondition		(world_property(properties["corpse_exist"],		false))
end

function set_corpse_detection(npc, ini, scheme, section)
	local st = xr_logic.assign_storage_and_bind(npc, ini, scheme, section)
end


function reset_corpse_detection(npc, scheme, st, section)
	st.corpse_detection.corpse_detection_enabled = utils.cfg_get_bool(st.ini, section, "corpse_detection_enabled", npc, false, true)
end

function is_under_corpse_detection(npc)
	local mgr = npc:motivation_action_manager()

	if not mgr:initialized() then
		return false
	end

	local current_action_id = mgr:current_action_id() 
	return  current_action_id == xr_actions_id.corpse_exist
end